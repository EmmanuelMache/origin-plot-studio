win -a L9a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 280;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 280;
layer -i200 D4a_B;
set D4a_B -c color(214,39,40);
set D4a_B -w 280;
layer -i200 D5a_B;
set D5a_B -c color(44,160,44);
set D5a_B -w 280;
layer -i200 D6a_B;
set D6a_B -c color(148,103,189);
set D6a_B -w 280;
layer -i200 D7a_B;
set D7a_B -c color(255,127,14);
set D7a_B -w 280;
layer.x.type=1;
layer.y.type=1;
layer.x.from=31; layer.x.to=35;
layer.y.from=-0.24838071; layer.y.to=5.2499229;
layer.x.inc=0.5;
layer.x.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=0;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 33 0 -n T1 x;
T1.text$="2θ (°), Cu Kα";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=33;
T1.y=-0.672644;
label -a 30.9185 2.50077 -n T2 x;
T2.text$="Normalised intensity (offset)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=30.9185;
T2.y=2.50077;
layer -i200 L8a_B;
set L8a_B -c color(136,136,136);
set L8a_B -w 280;
set L8a_B -d 2;
layer -i200 L9a_B;
set L9a_B -c color(136,136,136);
set L9a_B -w 280;
set L9a_B -d 2;
