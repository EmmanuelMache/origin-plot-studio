win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_shift/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
win -t data origin L8a;
win -a L8a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_shift/L8a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L8a]1!;
