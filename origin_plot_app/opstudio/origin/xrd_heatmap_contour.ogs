// Template xrd_heatmap_contour: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=65.100; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=78.375; layer.top=12.000; layer.width=2.406; layer.height=77.000;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=9.9687109; layer.x.to=60.031289;
layer.y.from=-0.40677966; layer.y.to=48.40678;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="2θ (°), Cu Kα";
xb.fsize=9;
yl.text$="Hydration time (h)";
yl.fsize=9;
win -a d1a;
page.active=2;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=1;
layer.y.from=50.017505; layer.y.to=925.0567;
layer.x.showAxes=1;
layer.y.showAxes=1;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=0;
layer.y2.ticks=0;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Intensity (counts)";
yl.fsize=9;
win -a d1a; insertImg2g fname:="<data folder>/demo_xrd_heatmap_contour_app_figure.png";
