// Template pca_biplot: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.953*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i201 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i201 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -k 2;
set D3a_B -z 6;
set D3a_B -kf 1;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i201 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -k 2;
set D4a_B -z 6;
set D4a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-3.3152167; layer.x.to=2.5905196;
layer.y.from=-2.8824059; layer.y.to=2.9975314;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="PC1 (38 %)";
xb.fsize=9;
yl.text$="PC2 (32 %)";
yl.fsize=9;
win -t data origin L5a;
win -a L5a; impASC fname:="<data folder>/data_for_origin/L5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L5a]1!;
win -a L5a;
layer -i200 L5a_B;
set L5a_B -c color(187,187,187);
set L5a_B -w 250;
win -t data origin L6a;
win -a L6a; impASC fname:="<data folder>/data_for_origin/L6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L6a]1!;
win -a L6a;
layer -i200 L6a_B;
set L6a_B -c color(187,187,187);
set L6a_B -w 250;
label -a 0.201116 -2.61213 -n T1 x;
T1.text$="Var 1";
T1.fsize=6;
T1.color=color(192,20,30);
T1.attach=2;
T1.x=0.201116+T1.dx/2;
T1.y=-2.61213+T1.dy/2;
label -a -2.22881 0.420445 -n T2 x;
T2.text$="Var 2";
T2.fsize=6;
T2.color=color(192,20,30);
T2.attach=2;
T2.x=-2.22881+T2.dx/2;
T2.y=0.420445+T2.dy/2;
label -a -2.25387 0.202887 -n T3 x;
T3.text$="Var 3";
T3.fsize=6;
T3.color=color(192,20,30);
T3.attach=2;
T3.x=-2.25387+T3.dx/2;
T3.y=0.202887+T3.dy/2;
label -a 0.439013 -2.72991 -n T4 x;
T4.text$="Var 4";
T4.fsize=6;
T4.color=color(192,20,30);
T4.attach=2;
T4.x=0.439013+T4.dx/2;
T4.y=-2.72991+T4.dy/2;
label -a 2.42269 1.28707 -n T5 x;
T5.text$="Var 5";
T5.fsize=6;
T5.color=color(192,20,30);
T5.attach=2;
T5.x=2.42269+T5.dx/2;
T5.y=1.28707+T5.dy/2;
legend -r;
legend.text$="\l(1) Group A\n\l(2) Group B\n\l(3) Group C";
legend.fsize=6;
legend.background=0;
legend.x=-3.22561+legend.dx/2;
legend.y=2.88977-legend.dy/2;
