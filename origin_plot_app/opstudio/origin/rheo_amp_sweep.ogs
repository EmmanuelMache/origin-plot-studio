// Template rheo_amp_sweep: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
set D2a_B -k 2;
set D2a_B -z 5;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i202 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 500;
set D3a_B -k 1;
set D3a_B -z 5;
set D3a_B -kf 1;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i201 D4a_B;
set D4a_B -c color(0,0,0);
set D4a_B -k 8;
set D4a_B -z 13;
layer.x.type=2;
layer.y.type=2;
layer.x.from=0.00056234133; layer.x.to=177.82794;
layer.y.from=3.4347482; layer.y.to=94473.607;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Shear strain γ (%)";
xb.fsize=9;
yl.text$="G′, G″ (Pa)";
yl.fsize=9;
win -t data origin L5a;
win -a L5a; impASC fname:="<data folder>/data_for_origin/L5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L5a]1!;
win -a L5a;
layer -i200 L5a_B;
set L5a_B -c color(85,85,85);
set L5a_B -w 400;
set L5a_B -d 2;
label -a 0.00517947 5.15212 -n T1 x;
T1.text$=" LVE limit";
T1.fsize=6;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.00517947+T1.dx/2;
T1.y=5.15212+T1.dy/2;
legend -r;
legend.text$="\l(1) G′\n\l(2) G″\n\l(3) Crossover γ ≈ 0.087 %";
legend.fsize=8;
legend.background=0;
legend.x=7.12204+legend.dx/2;
legend.y=1162.76-legend.dy/2;
