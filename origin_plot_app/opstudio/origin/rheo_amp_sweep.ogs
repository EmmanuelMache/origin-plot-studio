// Template rheo_amp_sweep: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_rheo_amp_sweep/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_rheo_amp_sweep/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_rheo_amp_sweep/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin L5a;
win -a L5a; impASC fname:="<data folder>/data_for_origin/demo_rheo_amp_sweep/L5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L5a]1!;
win -a L5a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 400;
set D2a_B -k 2;
set D2a_B -z 3;
layer -i202 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 400;
set D3a_B -k 1;
set D3a_B -z 3;
set D3a_B -kf 1;
layer -i201 D4a_B;
set D4a_B -c color(0,0,0);
set D4a_B -k 8;
set D4a_B -z 7;
layer.x.type=2;
layer.y.type=2;
layer.x.from=0.00056234133; layer.x.to=177.82794;
layer.y.from=3.4347482; layer.y.to=94473.607;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.316228 1.46522 -n T1 x;
T1.text$="Shear strain γ (%)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.316228;
T1.y=1.46522;
label -a 0.000267567 569.643 -n T2 x;
T2.text$="G′, G″ (Pa)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=0.000267567;
T2.y=569.643;
layer -i200 L5a_B;
set L5a_B -c color(85,85,85);
set L5a_B -w 320;
set L5a_B -d 2;
label -a 0.00517947 5.15212 -n T3 x;
T3.text$="LVE limit";
T3.fsize=5;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=0.00517947+T3.dx/2;
T3.y=5.15212+T3.dy/2;
win -a d1a;
page.active=1;
label -a 7.45366 889.915 -n T4 x;
T4.text$="\l(1) G′";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=7.45366+T4.dx/2;
T4.y=889.915;
label -a 7.45366 569.643 -n T5 x;
T5.text$="\l(2) G″";
T5.fsize=6;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=7.45366+T5.dx/2;
T5.y=569.643;
label -a 6.9092 364.634 -n T6 x;
T6.text$="\l(3) Crossover γ ≈ 0.087 %";
T6.fsize=6;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=6.9092+T6.dx/2;
T6.y=364.634;
win -a d1a;
page.active=1;
layer.x.type=2;
