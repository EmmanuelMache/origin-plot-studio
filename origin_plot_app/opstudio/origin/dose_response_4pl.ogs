// Template dose_response_4pl: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
win -t data origin D8a;
win -a D8a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D8a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D8a]1!;
win -a D8a;
win -t data origin D9a;
win -a D9a; impASC fname:="<data folder>/data_for_origin/demo_dose_response_4pl/D9a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D9a]1!;
win -a D9a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
layer -i201 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -k 9;
set D3a_B -z 6;
layer -i201 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -k 9;
set D4a_B -z 6;
layer -i200 D5a_B;
set D5a_B -c color(31,119,180);
set D5a_B -w 500;
layer -i201 D6a_B;
set D6a_B -c color(214,39,40);
set D6a_B -k 2;
set D6a_B -z 6;
set D6a_B -kf 1;
layer -i201 D7a_B;
set D7a_B -c color(214,39,40);
set D7a_B -k 9;
set D7a_B -z 6;
layer -i201 D8a_B;
set D8a_B -c color(214,39,40);
set D8a_B -k 9;
set D8a_B -z 6;
layer -i200 D9a_B;
set D9a_B -c color(214,39,40);
set D9a_B -w 500;
layer.x.type=2;
layer.y.type=1;
layer.x.from=0.0063095734; layer.x.to=158.48932;
layer.y.from=-10.484874; layer.y.to=113.74279;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Concentration (µM)";
xb.fsize=9;
yl.text$="Response (%)";
yl.fsize=9;
legend -r;
legend.text$="\l(4) Compound A: EC\-(50) = 0.81\n\l(8) Compound B: EC\-(50) = 6.2";
legend.fsize=8;
legend.background=0;
legend.x=0.00691083+legend.dx/2;
legend.y=111.945-legend.dy/2;
