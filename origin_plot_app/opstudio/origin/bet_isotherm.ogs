// Template bet_isotherm: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.625*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_bet_isotherm/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i202 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 500;
set D2a_B -k 2;
set D2a_B -z 6;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_bet_isotherm/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i202 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 500;
set D3a_B -k 1;
set D3a_B -z 6;
set D3a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.039; layer.x.to=1.039;
layer.y.from=1.2598504; layer.y.to=87.956429;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Relative pressure p/p\-(0)";
xb.fsize=9;
yl.text$="Quantity adsorbed (cm\+(3) g\+(-1) STP)";
yl.fsize=9;
legend -r;
legend.text$="\l(1) Adsorption\n\l(2) Desorption";
legend.fsize=8;
legend.background=0;
legend.x=-0.0185541+legend.dx/2;
legend.y=85.7222-legend.dy/2;
