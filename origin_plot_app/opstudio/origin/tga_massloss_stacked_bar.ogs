// Template tga_massloss_stacked_bar: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -a d1a;
page.active=1;
layer -i203 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 250;
set D2a_B -cf color(31,119,180);
set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
layer.bar.gap=35;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -a d1a;
page.active=1;
layer -i203 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 250;
set D3a_B -cf color(214,39,40);
set D3a_B -c color(0,0,0);
set D3a_B -w 250;
set D3a_B -z 6;
layer.bar.gap=35;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -a d1a;
page.active=1;
layer -i203 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 250;
set D4a_B -cf color(44,160,44);
set D4a_B -c color(0,0,0);
set D4a_B -w 250;
set D4a_B -z 6;
layer.bar.gap=35;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -a d1a;
page.active=1;
layer -i203 D5a_B;
set D5a_B -c color(148,103,189);
set D5a_B -w 250;
set D5a_B -cf color(148,103,189);
set D5a_B -c color(0,0,0);
set D5a_B -w 250;
set D5a_B -z 6;
layer.bar.gap=35;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.6075; layer.x.to=5.6075;
layer.y.from=0; layer.y.to=19.58;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Sample";
xb.fsize=9;
yl.text$="Mass loss (wt.%, ignited basis)";
yl.fsize=9;
label -a 0 0 -n T1 x;
T1.text$="Sample A";
T1.fsize=8;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0;
T1.y=0-T1.dy/2;
label -a 1 0 -n T2 x;
T2.text$="Sample B";
T2.fsize=8;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=1;
T2.y=0-T2.dy/2;
label -a 2 0 -n T3 x;
T3.text$="Sample C";
T3.fsize=8;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=2;
T3.y=0-T3.dy/2;
label -a 3 0 -n T4 x;
T4.text$="Sample D";
T4.fsize=8;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=3;
T4.y=0-T4.dy/2;
label -a 4 0 -n T5 x;
T5.text$="Sample E";
T5.fsize=8;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=4;
T5.y=0-T5.dy/2;
label -a 5 0 -n T6 x;
T6.text$="Sample F";
T6.fsize=8;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=5;
T6.y=0-T6.dy/2;
layer.x.showLabels=0;
legend -r;
legend.text$="\l(1) 30–200 °C\n\l(2) 200–400 °C\n\l(3) 400–550 °C\n\l(4) 550–800 °C";
legend.fsize=8;
legend.background=0;
legend.x=5.72549+legend.dx/2;
legend.y=19.2967-legend.dy/2;
