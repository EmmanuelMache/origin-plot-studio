// Template liquid_fraction_vs_T: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t data origin L7a;
win -a L7a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/L7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L7a]1!;
win -a L7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 500;
layer -i200 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 500;
layer -i200 D5a_B;
set D5a_B -c color(148,103,189);
set D5a_B -w 500;
layer -i200 D6a_B;
set D6a_B -c color(255,127,14);
set D6a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=1185; layer.x.to=1515;
layer.y.from=-4.5489843; layer.y.to=95.52867;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="Liquid fraction (wt.%)";
yl.fsize=9;
layer -i200 L7a_B;
set L7a_B -c color(136,136,136);
set L7a_B -w 350;
set L7a_B -d 1;
legend -r;
legend.text$="\l(1) Sample B\n\l(2) Sample C\n\l(3) Sample D\n\l(4) Sample E\n\l(5) Sample F";
legend.fsize=8;
legend.background=0;
legend.x=1187.96+legend.dx/2;
legend.y=94.0807-legend.dy/2;
