win -a L7a; impASC fname:="<data folder>/data_for_origin/demo_liquid_fraction_vs_T/L7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L7a]1!;
win -a L7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 400;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 400;
layer -i200 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 400;
layer -i200 D5a_B;
set D5a_B -c color(148,103,189);
set D5a_B -w 400;
layer -i200 D6a_B;
set D6a_B -c color(255,127,14);
set D6a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=1185; layer.x.to=1515;
layer.y.from=-4.5489843; layer.y.to=95.52867;
layer.x.inc=50;
layer.x.minor=4;
layer.y.inc=20;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 1350 0 -n T1 x;
T1.text$="Temperature (°C)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=1350;
T1.y=-12.2712;
