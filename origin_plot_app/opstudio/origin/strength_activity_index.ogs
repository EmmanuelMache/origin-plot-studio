// Template strength_activity_index: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_strength_activity_index/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_strength_activity_index/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_strength_activity_index/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin L5a;
win -a L5a; impASC fname:="<data folder>/data_for_origin/demo_strength_activity_index/L5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L5a]1!;
win -a L5a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -a d1a;
page.active=1;
layer -i203 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 250;
set D2a_B -cf color(31,119,180);
set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
layer.bar.gap=73;
win -a d1a;
page.active=1;
layer -i203 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 250;
set D3a_B -cf color(214,39,40);
set D3a_B -c color(0,0,0);
set D3a_B -w 250;
set D3a_B -z 6;
layer.bar.gap=73;
win -a d1a;
page.active=1;
layer -i203 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 250;
set D4a_B -cf color(44,160,44);
set D4a_B -c color(0,0,0);
set D4a_B -w 250;
set D4a_B -z 6;
layer.bar.gap=73;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.59; layer.x.to=3.59;
layer.y.from=0; layer.y.to=101.85;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Mix";
xb.fsize=9;
yl.text$="Relative strength (% of reference)";
yl.fsize=9;
label -a 0 0 -n T1 x;
T1.text$="Sample C";
T1.fsize=8;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0;
T1.y=0-T1.dy/2;
label -a 1 0 -n T2 x;
T2.text$="Sample D";
T2.fsize=8;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=1;
T2.y=0-T2.dy/2;
label -a 2 0 -n T3 x;
T3.text$="Sample E";
T3.fsize=8;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=2;
T3.y=0-T3.dy/2;
label -a 3 0 -n T4 x;
T4.text$="Sample F";
T4.fsize=8;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=3;
T4.y=0-T4.dy/2;
layer.x.showLabels=0;
layer -i200 L5a_B;
set L5a_B -c color(0,0,0);
set L5a_B -w 300;
legend -r;
legend.text$="\l(1) 7 d\n\l(2) 28 d\n\l(3) 90 d";
legend.fsize=8;
legend.background=0;
legend.x=2.20231+legend.dx/2;
legend.y=100.376-legend.dy/2;
