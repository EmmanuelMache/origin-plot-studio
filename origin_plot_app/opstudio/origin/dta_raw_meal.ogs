page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -a d1a;
page.active=1;
layer -i204 B2a_B;
set B2a_B -c color(252,236,221);
set B2a_B -w 100;
