// Template dta_raw_meal: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin B2a;
win -a B2a; impASC fname:="<data folder>/data_for_origin/demo_dta_raw_meal/B2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B2a]1!;
win -a B2a;
win -a d1a;
page.active=1;
layer -i204 B2a_B;
set B2a_B -c color(252,236,221);
set B2a_B -w 100;
set B2a_B -cf color(252,236,221);
set B2a_B -c color(0,0,0);
set B2a_B -w 250;
set B2a_B -z 6;
set B2a_B -pf 1;
win -t data origin B3a;
win -a B3a; impASC fname:="<data folder>/data_for_origin/demo_dta_raw_meal/B3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B3a]1!;
win -a B3a;
win -a d1a;
page.active=1;
layer -i204 B3a_B;
set B3a_B -c color(221,235,247);
set B3a_B -w 100;
set B3a_B -cf color(221,235,247);
set B3a_B -c color(0,0,0);
set B3a_B -w 250;
set B3a_B -z 6;
set B3a_B -pf 1;
win -t data origin B4a;
win -a B4a; impASC fname:="<data folder>/data_for_origin/demo_dta_raw_meal/B4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B4a]1!;
win -a B4a;
win -a d1a;
page.active=1;
layer -i204 B4a_B;
set B4a_B -c color(252,236,221);
set B4a_B -w 100;
set B4a_B -cf color(252,236,221);
set B4a_B -c color(0,0,0);
set B4a_B -w 250;
set B4a_B -z 6;
set B4a_B -pf 1;
win -t data origin B5a;
win -a B5a; impASC fname:="<data folder>/data_for_origin/demo_dta_raw_meal/B5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B5a]1!;
win -a B5a;
win -a d1a;
page.active=1;
layer -i204 B5a_B;
set B5a_B -c color(252,236,221);
set B5a_B -w 100;
set B5a_B -cf color(252,236,221);
set B5a_B -c color(0,0,0);
set B5a_B -w 250;
set B5a_B -z 6;
set B5a_B -pf 1;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_dta_raw_meal/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i200 D6a_B;
set D6a_B -c color(0,0,0);
set D6a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=100; layer.x.to=1400;
layer.y.from=-2.4892434; layer.y.to=0.72291785;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="DTA (µV mg\+(-1))";
yl.fsize=9;
label -a 550 0.755039 -n T1 x;
T1.text$="Clay dehydroxylation?";
T1.fsize=6;
T1.color=color(161,98,7);
T1.attach=2;
T1.x=550;
T1.y=0.755039+T1.dy/2;
label -a 790 1.01201 -n T2 x;
T2.text$="Decarbonation";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=790;
T2.y=1.01201+T2.dy/2;
label -a 1200 0.755039 -n T3 x;
T3.text$="Belite formation?";
T3.fsize=6;
T3.color=color(161,98,7);
T3.attach=2;
T3.x=1200;
T3.y=0.755039+T3.dy/2;
label -a 1310 1.01201 -n T4 x;
T4.text$="Melt / alite?";
T4.fsize=6;
T4.color=color(161,98,7);
T4.attach=2;
T4.x=1310;
T4.y=1.01201+T4.dy/2;
label -a 126 0.465945 -n T5 x;
T5.text$="exo ↑";
T5.fsize=7;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=126+T5.dx/2;
T5.y=0.465945+T5.dy/2;
win -a d1a;
page.active=1;
label -a -92.9032 -2.90641 -n T6 x;
T6.text$="\b(Orange = suggested label awaiting confirmation (never exported as final))";
T6.fsize=6;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=-92.9032+T6.dx/2;
T6.y=-2.90641-T6.dy/2;
