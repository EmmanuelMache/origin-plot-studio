win -a D9a; impASC fname:="<data folder>/data_for_origin/D9a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D9a]1!;
