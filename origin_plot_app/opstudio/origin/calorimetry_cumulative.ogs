win -a D8a; impASC fname:="<data folder>/data_for_origin/D8a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D8a]1!;
win -a D8a;
