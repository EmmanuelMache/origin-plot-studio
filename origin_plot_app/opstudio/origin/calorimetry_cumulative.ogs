win -a D10a;
layer -i200 D10a_B;
set D10a_B -c color(0,0,0);
set D10a_B -w 350;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=168;
layer.y.from=-25.940817; layer.y.to=559.79179;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Time (h)";
xb.fsize=9;
yl.text$="Cumulative heat (J g\+(-1))";
yl.fsize=9;
label -a 173.88 517.416 -n T1 x;
T1.text$="\b(Group I)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=173.88+T1.dx/2;
T1.y=517.416-T1.dy/2;
label -a 173.88 441.592 -n T2 x;
T2.text$="\b(Group II)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=173.88+T2.dx/2;
T2.y=441.592-T2.dy/2;
label -a 173.88 258.749 -n T3 x;
T3.text$="\b(Group III)";
T3.fsize=7;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=173.88+T3.dx/2;
T3.y=258.749-T3.dy/2;
legend -r;
legend.text$="\l(1) Sample A\n\l(2) Sample B\n\l(3) Sample C\n\l(4) Sample D\n\l(5) Sample E\n\l(6) Sample F";
legend.fsize=8;
legend.background=0;
legend.x=1.50934+legend.dx/2;
legend.y=551.317-legend.dy/2;
