// Template ridgeline: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_ridgeline/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_ridgeline/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_ridgeline/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_ridgeline/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_ridgeline/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i204 D2a_B;
set D2a_B -c color(121,173,210);
set D2a_B -w 250;
set D2a_B -cf color(121,173,210);
layer -i204 D3a_B;
set D3a_B -c color(230,125,126);
set D3a_B -w 250;
set D3a_B -cf color(230,125,126);
layer -i204 D4a_B;
set D4a_B -c color(128,198,128);
set D4a_B -w 250;
set D4a_B -cf color(128,198,128);
layer -i204 D5a_B;
set D5a_B -c color(191,164,215);
set D5a_B -w 250;
set D5a_B -cf color(191,164,215);
layer -i204 D6a_B;
set D6a_B -c color(255,178,110);
set D6a_B -w 250;
set D6a_B -cf color(255,178,110);
layer.x.type=1;
layer.y.type=1;
layer.x.from=5.4000427; layer.x.to=20.152963;
layer.y.from=-0.28; layer.y.to=5.88;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=0;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Measured value (unit)";
xb.fsize=9;
yl.show=0;
label -a 6.07063 0.1 -n T1 x;
T1.text$="G1";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=6.07063+T1.dx/2;
T1.y=0.1+T1.dy/2;
label -a 6.07063 1.1 -n T2 x;
T2.text$="G2";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=6.07063+T2.dx/2;
T2.y=1.1+T2.dy/2;
label -a 6.07063 2.1 -n T3 x;
T3.text$="G3";
T3.fsize=7;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=6.07063+T3.dx/2;
T3.y=2.1+T3.dy/2;
label -a 6.07063 3.1 -n T4 x;
T4.text$="G4";
T4.fsize=7;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=6.07063+T4.dx/2;
T4.y=3.1+T4.dy/2;
label -a 6.07063 4.1 -n T5 x;
T5.text$="G5";
T5.fsize=7;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=6.07063+T5.dx/2;
T5.y=4.1+T5.dy/2;
