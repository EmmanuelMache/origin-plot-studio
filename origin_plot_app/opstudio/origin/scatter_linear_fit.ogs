// Template scatter_linear_fit: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_scatter_linear_fit/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_scatter_linear_fit/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_scatter_linear_fit/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.625*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 4;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(192,20,30);
set D3a_B -w 400;
layer -i204 D4a_B;
set D4a_B -c color(247,227,228);
set D4a_B -w 200;
set D4a_B -cf color(247,227,228);
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.75; layer.x.to=15.75;
layer.y.from=4.1767924; layer.y.to=61.887667;
layer.x.inc=5;
layer.x.minor=4;
layer.y.inc=10;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 7.5 0 -n T1 x;
T1.text$="Additive (wt.%)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=7.5;
T1.y=-3.75533;
label -a 0 33.0322 -n T2 x;
T2.text$="Alite (wt.%)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-2.47247;
T2.y=33.0322;
win -a d1a;
page.active=1;
label -a 5.34093 57.7111 -n T3 x;
T3.text$="\l(1) Data";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=5.34093+T3.dx/2;
T3.y=57.7111;
label -a 5.50784 52.9157 -n T4 x;
T4.text$="\l(2) y = -2.96x + 55.8, R\+(2) = 0.966";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=5.50784+T4.dx/2;
T4.y=52.9157;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.75; layer.x.to=15.75;
layer.y.from=4.1767924; layer.y.to=61.887667;
layer.x.inc=5;
layer.x.minor=4;
layer.y.inc=10;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
