// Template parity_plot: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_parity_plot/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_parity_plot/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_parity_plot/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_parity_plot/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.835*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=20.450; layer.top=12.000; layer.width=61.600; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 403;
layer -i201 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -k 2;
set D3a_B -z 4;
set D3a_B -kf 1;
layer -i201 D4a_B;
set D4a_B -c color(214,39,40);
set D4a_B -k 1;
set D4a_B -z 4;
set D4a_B -kf 1;
layer -i204 D5a_B;
set D5a_B -c color(238,238,238);
set D5a_B -w 252;
set D5a_B -cf color(238,238,238);
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=64.323962;
layer.y.from=0; layer.y.to=64.323962;
layer.x.inc=20;
layer.x.minor=3;
layer.y.inc=10;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.805;
layer.y.thickness=0.805;
layer.x2.thickness=0.805;
layer.y2.thickness=0.805;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 32.162 0 -n T1 x;
T1.text$="Rietveld QPA (wt.%)";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=32.162;
T1.y=-8.18617;
label -a 0 32.162 -n T2 x;
T2.text$="Calculated (wt.%)";
T2.fsize=9;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-8.44813;
T2.y=32.162;
win -a d1a;
page.active=1;
label -a 1.94422 60.0136 -n T3 x;
T3.text$="\l(2) Bogue (RMSE 3.3)";
T3.fsize=8;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=1.94422+T3.dx/2;
T3.y=60.0136;
