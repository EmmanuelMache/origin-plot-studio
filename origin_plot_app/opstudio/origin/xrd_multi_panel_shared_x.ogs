// Template xrd_multi_panel_shared_x: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=5.541*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=24.367;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=38.316; layer.width=77.500; layer.height=24.367;
win -a d1a;
layer -n;
page.active=3;
layer.unit=1;
layer.left=12.500; layer.top=64.633; layer.width=77.500; layer.height=24.367;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_xrd_multi_panel_shared_x/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 350;
layer.x.type=1;
layer.y.type=1;
layer.x.from=10; layer.x.to=60;
layer.y.from=0; layer.y.to=2456.2092;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Counts";
yl.fsize=9;
label -a 10.5 2259.71 -n T1 x;
T1.text$="\b((a) Material 1)";
T1.fsize=8;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=10.5+T1.dx/2;
T1.y=2259.71-T1.dy/2;
win -a d1a;
page.active=2;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_xrd_multi_panel_shared_x/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
