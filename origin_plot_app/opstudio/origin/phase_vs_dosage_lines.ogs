// Template phase_vs_dosage_lines: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=20.612; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=40.944; layer.top=12.000; layer.width=20.612; layer.height=77.000;
win -a d1a;
layer -n;
page.active=3;
layer.unit=1;
layer.left=69.388; layer.top=12.000; layer.width=20.612; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_phase_vs_dosage_lines/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i202 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 500;
set D2a_B -k 2;
set D2a_B -z 6;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_phase_vs_dosage_lines/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i202 D3a_B;
set D3a_B -c color(0,114,178);
set D3a_B -w 500;
set D3a_B -d 1;
set D3a_B -k 1;
set D3a_B -z 6;
set D3a_B -kf 1;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_phase_vs_dosage_lines/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i202 D4a_B;
set D4a_B -c color(213,94,0);
set D4a_B -w 500;
set D4a_B -d 2;
set D4a_B -k 3;
set D4a_B -z 6;
set D4a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-1; layer.x.to=21;
layer.y.from=0; layer.y.to=65.1;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Additive (wt.%)";
xb.fsize=9;
yl.text$="Content (wt.%)";
yl.fsize=9;
label -a -1 65.1 -n T1 x;
T1.text$="\b((a) Alite, C\-(3)S)";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=-1+T1.dx/2;
T1.y=65.1+T1.dy/2;
legend -r;
legend.text$="\l(1) Rietveld QPA (measured)\n\l(2) Series 1\n\l(3) Series 2";
legend.fsize=6;
legend.background=0;
legend.x=-0.405465+legend.dx/2;
legend.y=7.98702-legend.dy/2;
win -a d1a;
page.active=2;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_phase_vs_dosage_lines/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
