// Template pareto_front: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_pareto_front/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_pareto_front/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=65.100; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=78.375; layer.top=12.000; layer.width=2.406; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i202 D2a_B;
set D2a_B -c color(192,20,30);
set D2a_B -w 476;
set D2a_B -k 2;
set D2a_B -z 7;
set D2a_B -kf 1;
layer -i201 D3a_B;
set D3a_B -c color(72,32,113);
set D3a_B -k 2;
set D3a_B -z 5;
layer.x.type=1;
layer.y.type=1;
layer.x.from=17.352743; layer.x.to=81.285455;
layer.y.from=465.30118; layer.y.to=1036.5813;
layer.x.inc=10;
layer.x.minor=4;
layer.y.inc=100;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.762;
layer.y.thickness=0.762;
layer.x2.thickness=0.762;
layer.y2.thickness=0.762;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 49.3191 421.22 -n T1 x;
T1.text$="Performance (unit) →";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=49.3191;
T1.y=421.22;
