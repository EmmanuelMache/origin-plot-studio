// Template xrf_oxide_bar: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_xrf_oxide_bar/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -a d1a;
page.active=1;
layer -i203 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 250;
set D2a_B -cf color(31,119,180);
set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
layer.bar.gap=60;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_xrf_oxide_bar/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -a d1a;
page.active=1;
layer -i203 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 250;
set D3a_B -cf color(214,39,40);
set D3a_B -c color(0,0,0);
set D3a_B -w 250;
set D3a_B -z 6;
layer.bar.gap=60;
layer.x.type=1;
layer.y.type=2;
layer.x.from=-0.84; layer.x.to=8.84;
layer.y.from=0.18939086; layer.y.to=85.141383;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Content (wt.%)";
yl.fsize=9;
label -a 0 0.189391 -n T1 x;
T1.text$="CaO";
T1.fsize=8;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0;
T1.y=0.189391-T1.dy/2;
label -a 1 0.189391 -n T2 x;
T2.text$="SiO\-(2)";
T2.fsize=8;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=1;
T2.y=0.189391-T2.dy/2;
label -a 2 0.189391 -n T3 x;
T3.text$="Al\-(2)O\-(3)";
T3.fsize=8;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=2;
T3.y=0.189391-T3.dy/2;
label -a 3 0.189391 -n T4 x;
T4.text$="Fe\-(2)O\-(3)";
T4.fsize=8;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=3;
T4.y=0.189391-T4.dy/2;
label -a 4 0.189391 -n T5 x;
T5.text$="MgO";
T5.fsize=8;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=4;
T5.y=0.189391-T5.dy/2;
label -a 5 0.189391 -n T6 x;
T6.text$="SO\-(3)";
T6.fsize=8;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=5;
T6.y=0.189391-T6.dy/2;
label -a 6 0.189391 -n T7 x;
T7.text$="K\-(2)O";
T7.fsize=8;
T7.color=color(0,0,0);
T7.attach=2;
T7.x=6;
T7.y=0.189391-T7.dy/2;
label -a 7 0.189391 -n T8 x;
T8.text$="Na\-(2)O";
T8.fsize=8;
T8.color=color(0,0,0);
T8.attach=2;
T8.x=7;
T8.y=0.189391-T8.dy/2;
label -a 8 0.189391 -n T9 x;
T9.text$="TiO\-(2)";
T9.fsize=8;
T9.color=color(0,0,0);
T9.attach=2;
T9.x=8;
T9.y=0.189391-T9.dy/2;
layer.x.showLabels=0;
legend -r;
legend.text$="\l(1) Sample B\n\l(2) Additive";
legend.fsize=8;
legend.background=0;
legend.x=5.93671+legend.dx/2;
legend.y=77.94-legend.dy/2;
