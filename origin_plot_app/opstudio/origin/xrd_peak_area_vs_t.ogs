// Template xrd_peak_area_vs_t: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_area_vs_t/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_area_vs_t/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i201 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -k 9;
set D3a_B -z 8;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_area_vs_t/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i201 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -k 9;
set D4a_B -z 8;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_area_vs_t/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
layer -i202 D5a_B;
set D5a_B -c color(214,39,40);
set D5a_B -w 500;
set D5a_B -k 1;
set D5a_B -z 6;
set D5a_B -kf 1;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_area_vs_t/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i201 D6a_B;
set D6a_B -c color(214,39,40);
set D6a_B -k 9;
set D6a_B -z 8;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_xrd_peak_area_vs_t/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
layer -i201 D7a_B;
set D7a_B -c color(214,39,40);
set D7a_B -k 9;
set D7a_B -z 8;
layer.x.type=2;
layer.y.type=1;
layer.x.from=0.38566158; layer.x.to=116.68261;
layer.y.from=-8.0250304; layer.y.to=102.62552;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Time (days)";
xb.fsize=9;
yl.text$="Integrated peak area (a.u.)";
yl.fsize=9;
legend -r;
legend.text$="Phase 1\nPhase 2";
legend.fsize=8;
legend.background=0;
legend.x=53.0692+legend.dx/2;
legend.y=101.025-legend.dy/2;
