win -a D7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 400;
set D2a_B -k 2;
set D2a_B -z 4;
set D2a_B -kf 1;
layer -i201 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -k 9;
set D3a_B -z 4;
layer -i201 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -k 9;
set D4a_B -z 4;
layer -i202 D5a_B;
set D5a_B -c color(214,39,40);
set D5a_B -w 400;
set D5a_B -k 1;
set D5a_B -z 4;
set D5a_B -kf 1;
layer -i201 D6a_B;
set D6a_B -c color(214,39,40);
set D6a_B -k 9;
set D6a_B -z 4;
layer -i201 D7a_B;
set D7a_B -c color(214,39,40);
set D7a_B -k 9;
set D7a_B -z 4;
layer.x.type=2;
layer.y.type=1;
layer.x.from=0.38566158; layer.x.to=116.68261;
layer.y.from=-8.0250304; layer.y.to=102.62552;
layer.y.inc=20;
layer.y.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
