// Template fft_spectrum: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_fft_spectrum/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_fft_spectrum/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=31.429;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=57.571; layer.width=77.500; layer.height=31.429;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 200;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.049975; layer.x.to=1.049475;
layer.y.from=-2.5889493; layer.y.to=2.8255724;
layer.x.inc=0.2;
layer.x.minor=3;
layer.y.inc=2;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.49975 0 -n T1 x;
T1.text$="Time (s)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.49975;
T1.y=-3.61256;
label -a 0 0.118312 -n T2 x;
T2.text$="Signal (V)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-0.105606;
T2.y=0.118312;
label -a 0 2.93612 -n T3 x;
T3.text$="\b((a))";
T3.fsize=7;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=-0.049975+T3.dx/2;
T3.y=2.93612+T3.dy/2;
win -a d1a;
page.active=2;
layer -i200 D3a_B;
set D3a_B -c color(0,0,0);
set D3a_B -w 280;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=250;
layer.y.from=-0.049151183; layer.y.to=1.0395632;
layer.x.inc=50;
layer.x.minor=4;
layer.y.inc=0.25;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 125 0 -n T4 x;
T4.text$="Frequency (Hz)";
T4.fsize=7;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=125;
T4.y=-0.254971;
label -a 0 0.495206 -n T5 x;
T5.text$="Amplitude (V)";
T5.fsize=7;
T5.color=color(0,0,0);
T5.attach=2;
T5.rotate=90;
T5.x=-17.8605;
T5.y=0.495206;
