// Template fft_spectrum: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=31.429;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=57.571; layer.width=77.500; layer.height=31.429;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_fft_spectrum/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 250;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.049975; layer.x.to=1.049475;
layer.y.from=-2.5889493; layer.y.to=2.8255724;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Time (s)";
xb.fsize=9;
yl.text$="Signal (V)";
yl.fsize=9;
label -a -0.049975 2.82557 -n T1 x;
T1.text$="\b((a))";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=-0.049975+T1.dx/2;
T1.y=2.82557+T1.dy/2;
win -a d1a;
page.active=2;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_fft_spectrum/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(0,0,0);
set D3a_B -w 350;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=250;
layer.y.from=-0.049151183; layer.y.to=1.0395632;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Frequency (Hz)";
xb.fsize=9;
yl.text$="Amplitude (V)";
yl.fsize=9;
label -a 0 1.03956 -n T2 x;
T2.text$="\b((b))";
T2.fsize=9;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=0+T2.dx/2;
T2.y=1.03956+T2.dy/2;
label -a 1000 -0.0491512 -n T3 x;
T3.text$="120 Hz";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=1000+T3.dx/2;
T3.y=-0.0491512+T3.dy/2;
label -a 1000 -0.0491512 -n T4 x;
T4.text$="50 Hz";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=1000+T4.dx/2;
T4.y=-0.0491512+T4.dy/2;
