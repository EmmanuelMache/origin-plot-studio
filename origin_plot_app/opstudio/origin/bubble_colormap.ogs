// Template bubble_colormap: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_bubble_colormap/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=65.100; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=78.375; layer.top=12.000; layer.width=2.406; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(224,231,59);
set D2a_B -k 2;
set D2a_B -z 17;
layer.x.type=1;
layer.y.type=1;
layer.x.from=19.135352; layer.x.to=69.715521;
layer.y.from=226.75902; layer.y.to=918.06243;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Performance (unit)";
xb.fsize=9;
yl.text$="Impact (unit)";
yl.fsize=9;
legend -r;
legend.text$="1.2\n4.1\n10.0";
legend.fsize=8;
legend.background=0;
legend.x=61.5922+legend.dx/2;
legend.y=908.061-legend.dy/2;
win -a d1a;
page.active=2;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=1;
layer.y.from=0.024586107; layer.y.to=0.89575775;
layer.x.showAxes=1;
layer.y.showAxes=1;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=0;
layer.y2.ticks=0;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Colour variable";
yl.fsize=9;
win -a d1a; insertImg2g fname:="<data folder>/demo_bubble_colormap_app_figure.png";
