// Template chromatogram: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 350;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i204 D3a_B;
set D3a_B -c color(165,201,225);
set D3a_B -w 250;
set D3a_B -cf color(165,201,225);
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i204 D4a_B;
set D4a_B -c color(239,169,169);
set D4a_B -w 250;
set D4a_B -cf color(239,169,169);
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
layer -i204 D5a_B;
set D5a_B -c color(171,217,171);
set D5a_B -w 250;
set D5a_B -cf color(171,217,171);
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i204 D6a_B;
set D6a_B -c color(212,194,229);
set D6a_B -w 250;
set D6a_B -cf color(212,194,229);
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=15;
layer.y.from=-2.3508907; layer.y.to=58.778265;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Retention time (min)";
xb.fsize=9;
yl.text$="Detector signal (mV)";
yl.fsize=9;
label -a 2.1 32.6486 -n T1 x;
T1.text$="Peak 1\n2.10 min";
T1.fsize=6;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=2.1;
T1.y=32.6486+T1.dy/2;
label -a 4.6 57.4997 -n T2 x;
T2.text$="Peak 2\n4.60 min";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=4.6;
T2.y=57.4997+T2.dy/2;
label -a 5.1 24.7052 -n T3 x;
T3.text$="Peak 3\n5.10 min";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=5.1;
T3.y=24.7052+T3.dy/2;
label -a 9.8 42.6135 -n T4 x;
T4.text$="Peak 4\n9.80 min";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=9.8;
T4.y=42.6135+T4.dy/2;
