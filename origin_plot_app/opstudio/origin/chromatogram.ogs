// Template chromatogram: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_chromatogram/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 280;
layer -i204 D3a_B;
set D3a_B -c color(165,201,225);
set D3a_B -w 200;
set D3a_B -cf color(165,201,225);
layer -i204 D4a_B;
set D4a_B -c color(239,169,169);
set D4a_B -w 200;
set D4a_B -cf color(239,169,169);
layer -i204 D5a_B;
set D5a_B -c color(171,217,171);
set D5a_B -w 200;
set D5a_B -cf color(171,217,171);
layer -i204 D6a_B;
set D6a_B -c color(212,194,229);
set D6a_B -w 200;
set D6a_B -cf color(212,194,229);
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=15;
layer.y.from=-2.3508907; layer.y.to=58.778265;
layer.x.inc=2;
layer.x.minor=3;
layer.y.inc=10;
layer.y.minor=5;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 7.5 0 -n T1 x;
T1.text$="Retention time (min)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=7.5;
T1.y=-7.06778;
label -a 0 28.2137 -n T2 x;
T2.text$="Detector signal (mV)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-0.741732;
T2.y=28.2137;
label -a 2.1 34.5189 -n T3 x;
T3.text$="Peak 1";
T3.fsize=5;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=2.1;
T3.y=34.5189+T3.dy/2;
label -a 2.1 32.6486 -n T4 x;
T4.text$="2.10 min";
T4.fsize=5;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=2.1;
T4.y=32.6486+T4.dy/2;
label -a 4.6 59.3699 -n T5 x;
T5.text$="Peak 2";
T5.fsize=5;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=4.6;
T5.y=59.3699+T5.dy/2;
label -a 4.6 57.4997 -n T6 x;
T6.text$="4.60 min";
T6.fsize=5;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=4.6;
T6.y=57.4997+T6.dy/2;
label -a 5.1 26.5755 -n T7 x;
T7.text$="Peak 3";
T7.fsize=5;
T7.color=color(0,0,0);
T7.attach=2;
T7.x=5.1;
T7.y=26.5755+T7.dy/2;
label -a 5.1 24.7052 -n T8 x;
T8.text$="5.10 min";
T8.fsize=5;
T8.color=color(0,0,0);
T8.attach=2;
T8.x=5.1;
T8.y=24.7052+T8.dy/2;
label -a 9.8 44.4838 -n T9 x;
T9.text$="Peak 4";
T9.fsize=5;
T9.color=color(0,0,0);
T9.attach=2;
T9.x=9.8;
T9.y=44.4838+T9.dy/2;
label -a 9.8 42.6135 -n T10 x;
T10.text$="9.80 min";
T10.fsize=5;
T10.color=color(0,0,0);
T10.attach=2;
T10.x=9.8;
T10.y=42.6135+T10.dy/2;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=15;
layer.y.from=-2.3508907; layer.y.to=58.778265;
layer.x.inc=2;
layer.x.minor=3;
layer.y.inc=10;
layer.y.minor=5;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
