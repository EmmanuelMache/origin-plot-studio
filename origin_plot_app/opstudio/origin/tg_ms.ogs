// Template tg_ms: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=49.838;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=64.081; layer.width=77.500; layer.height=24.919;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_tg_ms/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-18.5; layer.x.to=1048.5;
layer.y.from=87.793614; layer.y.to=100.50961;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Mass (%)";
yl.fsize=9;
win -a d1a;
page.active=2;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_tg_ms/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 500;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_tg_ms/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i200 D4a_B;
set D4a_B -c color(214,39,40);
set D4a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-18.5; layer.x.to=1048.5;
layer.y.from=-0.049775565; layer.y.to=1.0519284;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="Ion current (a.u.)";
yl.fsize=9;
legend -r;
legend.text$="\l(1) m/z 18 (H\-(2)O)\n\l(2) m/z 44 (CO\-(2))";
legend.fsize=8;
legend.background=0;
legend.x=860.843+legend.dx/2;
legend.y=1.00268-legend.dy/2;
