set D15a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=1;
layer.y.from=0; layer.y.to=0.87;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.show=0;
label -a -0.03 -0.04 -n T1 x;
T1.text$="Component 1";
T1.fsize=8;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=-0.03+T1.dx/2;
T1.y=-0.04+T1.dy/2;
label -a 1.03 -0.04 -n T2 x;
T2.text$="Component 2";
T2.fsize=8;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=1.03+T2.dx/2;
T2.y=-0.04+T2.dy/2;
label -a 0.5 0.89 -n T3 x;
T3.text$="Component 3";
T3.fsize=8;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=0.5;
T3.y=0.89+T3.dy/2;
