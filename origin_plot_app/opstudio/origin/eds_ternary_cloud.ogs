// Template eds_ternary_cloud: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=3.081*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.769; layer.top=12.000; layer.width=76.962; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_eds_ternary_cloud/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(221,221,221);
set D2a_B -w 200;
