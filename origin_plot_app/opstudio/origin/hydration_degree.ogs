set D9a_B -k 9;
set D9a_B -z 8;
layer -i201 D10a_B;
set D10a_B -c color(44,160,44);
set D10a_B -k 9;
set D10a_B -z 8;
layer.x.type=2;
layer.y.type=1;
layer.x.from=0.79852382; layer.x.to=112.70797;
layer.y.from=17.651821; layer.y.to=95.919009;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Time (days)";
xb.fsize=9;
yl.text$="Degree of reaction (%)";
yl.fsize=9;
legend -r;
legend.text$="Method 1\nMethod 2\nMethod 3";
legend.fsize=8;
legend.background=0;
legend.x=0.834835+legend.dx/2;
legend.y=94.7866-legend.dy/2;
