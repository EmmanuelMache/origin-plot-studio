// Template raman_stacked: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_raman_stacked/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_raman_stacked/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_raman_stacked/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_raman_stacked/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_raman_stacked/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 280;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 280;
layer -i200 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 280;
layer -i200 D5a_B;
set D5a_B -c color(148,103,189);
set D5a_B -w 280;
layer -i200 D6a_B;
set D6a_B -c color(255,127,14);
set D6a_B -w 280;
layer.x.type=1;
layer.y.type=1;
layer.x.from=100; layer.x.to=1200;
layer.y.from=-0.34874508; layer.y.to=8.4338298;
layer.x.inc=200;
layer.x.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=0;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 650 0 -n T1 x;
T1.text$="Raman shift (cm\+(-1))";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=650;
T1.y=-1.04883;
label -a 77.5995 4.04254 -n T2 x;
T2.text$="Intensity (a.u., offset)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=77.5995;
T2.y=4.04254;
label -a 111 0.165256 -n T3 x;
T3.text$="Sample B";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=111+T3.dx/2;
T3.y=0.165256+T3.dy/2;
label -a 111 1.66236 -n T4 x;
T4.text$="Sample C";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=111+T4.dx/2;
T4.y=1.66236+T4.dy/2;
label -a 111 3.15947 -n T5 x;
T5.text$="Sample D";
T5.fsize=6;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=111+T5.dx/2;
T5.y=3.15947+T5.dy/2;
label -a 111 4.65658 -n T6 x;
T6.text$="Sample E";
T6.fsize=6;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=111+T6.dx/2;
T6.y=4.65658+T6.dy/2;
label -a 111 6.15368 -n T7 x;
T7.text$="Sample F";
T7.fsize=6;
T7.color=color(0,0,0);
T7.attach=2;
T7.x=111+T7.dx/2;
T7.y=6.15368+T7.dy/2;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=100; layer.x.to=1200;
layer.y.from=-0.34874508; layer.y.to=8.4338298;
layer.x.inc=200;
layer.x.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=0;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
