// Template dual_y_axis: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_dual_y_axis/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_dual_y_axis/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.625*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 400;
set D2a_B -k 2;
set D2a_B -z 4;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-1; layer.x.to=21;
layer.y.from=28.5; layer.y.to=61.5;
layer.x.inc=5;
layer.x.minor=4;
layer.y.inc=5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 10 23.9643 -n T1 x;
T1.text$="Additive (wt.%)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=10;
T1.y=23.9643;
label -a 0 45 -n T2 x;
T2.text$="Alite (wt.%)";
T2.fsize=7;
T2.color=color(31,119,180);
T2.attach=2;
T2.rotate=90;
T2.x=-3.29662;
T2.y=45;
win -a d1a;
page.active=2;
layer -i202 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 400;
set D3a_B -d 1;
set D3a_B -k 1;
set D3a_B -z 4;
set D3a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-1; layer.x.to=21;
layer.y.from=-5.4; layer.y.to=157.4;
layer.x.inc=5;
layer.x.minor=4;
layer.y.inc=25;
layer.y.minor=0;
layer.link=1;
layer.x.link=1;
layer.x.showAxes=0;
layer.y.showAxes=2;
layer.y.showLabels=0;
layer.y2.showLabels=1;
layer.y2.ticks=5;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 24.1087 76 -n T3 x;
T3.text$="Q\-(168) (J g\+(-1))";
T3.fsize=7;
T3.color=color(214,39,40);
T3.attach=2;
T3.rotate=90;
