win -a L7a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/L7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L7a]1!;
win -a L7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=56.068;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=70.311; layer.width=77.500; layer.height=18.689;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 4;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-2.5; layer.x.to=52.5;
layer.y.from=-0.10978562; layer.y.to=2.7069093;
layer.x.inc=10;
layer.x.minor=4;
layer.y.inc=0.5;
layer.y.minor=5;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0 1.29856 -n T1 x;
T1.text$="Signal (a.u.)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.rotate=90;
T1.x=-5.53593;
T1.y=1.29856;
