// Template calibration_lod: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin L4a;
win -a L4a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/L4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L4a]1!;
win -a L4a;
win -t data origin L5a;
win -a L5a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/L5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L5a]1!;
win -a L5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t data origin L7a;
win -a L7a; impASC fname:="<data folder>/data_for_origin/demo_calibration_lod/L7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L7a]1!;
win -a L7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=56.068;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=70.311; layer.width=77.500; layer.height=18.689;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-2.5; layer.x.to=52.5;
layer.y.from=-0.10978562; layer.y.to=2.7069093;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Signal (a.u.)";
yl.fsize=9;
layer -i200 L4a_B;
set L4a_B -c color(161,98,7);
set L4a_B -w 400;
set L4a_B -d 2;
layer -i200 L5a_B;
set L5a_B -c color(185,28,28);
set L5a_B -w 400;
set L5a_B -d 2;
legend -r;
legend.text$="\l(2) y = 0.0510x + 0.0182\nLOD = 0.98, LOQ = 2.97";
legend.fsize=8;
legend.background=0;
legend.x=-2.00587+legend.dx/2;
legend.y=2.65094-legend.dy/2;
win -a d1a;
page.active=2;
layer -i201 D6a_B;
set D6a_B -c color(0,0,0);
set D6a_B -k 2;
set D6a_B -z 6;
set D6a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-2.5; layer.x.to=52.5;
layer.y.from=-0.022818929; layer.y.to=0.018779266;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Concentration (mg L\+(-1))";
xb.fsize=9;
yl.text$="Resid.";
yl.fsize=9;
layer -i200 L7a_B;
set L7a_B -c color(31,119,180);
set L7a_B -w 500;
