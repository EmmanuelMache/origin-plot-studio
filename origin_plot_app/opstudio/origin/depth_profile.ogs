set D4a_B -c color(44,160,44);
set D4a_B -w 500;
set D4a_B -k 2;
set D4a_B -z 5;
set D4a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=10.134124; layer.x.to=14.301318;
layer.y.from=42; layer.y.to=-2;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=0;
layer.x.label.pt=8; layer.y.label.pt=8;
