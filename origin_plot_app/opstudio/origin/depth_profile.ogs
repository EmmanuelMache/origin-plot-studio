// Template depth_profile: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_depth_profile/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_depth_profile/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_depth_profile/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=23.920; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=39.290; layer.top=12.000; layer.width=23.920; layer.height=77.000;
win -a d1a;
layer -n;
page.active=3;
layer.unit=1;
layer.left=66.080; layer.top=12.000; layer.width=23.920; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 1296;
set D2a_B -k 2;
set D2a_B -z 9;
set D2a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0.015659875; layer.x.to=0.88973048;
layer.y.from=42; layer.y.to=-2;
layer.x.inc=0.25;
layer.x.minor=7;
layer.y.inc=5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=21; layer.y.label.pt=21;
layer.y2.label.pt=21;
layer.x.thickness=2.07;
layer.y.thickness=2.07;
layer.x2.thickness=2.07;
layer.y2.thickness=2.07;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.452695 45.3952 -n T1 x;
T1.text$="Chloride (wt.%)";
T1.fsize=23;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.452695;
T1.y=45.3952;
