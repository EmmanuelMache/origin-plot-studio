win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_xrd_ref_ticks/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=49.405;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=62.914; layer.width=77.500; layer.height=26.086;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 280;
layer.x.type=1;
layer.y.type=1;
layer.x.from=7.5; layer.x.to=62.5;
layer.y.from=16.433387; layer.y.to=1515.3867;
layer.x.inc=10;
layer.x.minor=4;
layer.y.inc=200;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
