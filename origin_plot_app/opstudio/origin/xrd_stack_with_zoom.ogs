// Template xrd_stack_with_zoom: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=56.985; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=71.005; layer.top=12.000; layer.width=18.995; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin B2a;
win -a B2a; impASC fname:="<data folder>/data_for_origin/demo_xrd_stack_with_zoom/B2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B2a]1!;
win -a B2a;
win -a d1a;
page.active=1;
layer -i204 B2a_B;
set B2a_B -c color(238,238,238);
set B2a_B -w 100;
set B2a_B -cf color(238,238,238);
set B2a_B -c color(0,0,0);
set B2a_B -w 250;
set B2a_B -z 6;
set B2a_B -pf 1;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_xrd_stack_with_zoom/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(34,34,34);
set D3a_B -w 350;
