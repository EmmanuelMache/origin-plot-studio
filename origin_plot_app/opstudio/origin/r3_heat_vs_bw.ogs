// Template r3_heat_vs_bw: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_r3_heat_vs_bw/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_r3_heat_vs_bw/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.625*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(192,20,30);
set D3a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=1.75; layer.x.to=9.45;
layer.y.from=103.46019; layer.y.to=550.4168;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Bound water (g per 100 g)";
xb.fsize=9;
yl.text$="Heat at 7 d (J g\+(-1))";
yl.fsize=9;
legend -r;
legend.text$="\l(2) y = 58 x + 1.88,  R\+(2) = 0.998";
legend.fsize=8;
legend.background=0;
legend.x=1.89604+legend.dx/2;
legend.y=538.898-legend.dy/2;
