// Template ea_vs_alpha: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_ea_vs_alpha/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_ea_vs_alpha/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_ea_vs_alpha/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_ea_vs_alpha/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_ea_vs_alpha/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_ea_vs_alpha/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
layer -i202 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 500;
set D3a_B -k 1;
set D3a_B -z 6;
set D3a_B -kf 1;
layer -i202 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 500;
set D4a_B -k 5;
set D4a_B -z 6;
set D4a_B -kf 1;
layer -i204 D5a_B;
set D5a_B -c color(228,239,246);
set D5a_B -w 250;
set D5a_B -cf color(228,239,246);
layer -i204 D6a_B;
set D6a_B -c color(250,229,229);
set D6a_B -w 250;
set D6a_B -cf color(250,229,229);
layer -i204 D7a_B;
set D7a_B -c color(230,244,230);
set D7a_B -w 250;
set D7a_B -cf color(230,244,230);
layer.x.type=1;
layer.y.type=1;
layer.x.from=0.06; layer.x.to=0.94;
layer.y.from=166.62; layer.y.to=205.78;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Conversion α (–)";
xb.fsize=9;
yl.text$="E\-(α) (kJ mol\+(-1))";
yl.fsize=9;
legend -r;
legend.text$="\l(1) Friedman\n\l(2) OFW\n\l(3) KAS";
legend.fsize=8;
legend.background=0;
legend.x=0.809518+legend.dx/2;
legend.y=172.654-legend.dy/2;
