// Template bogue_vs_qpa: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_bogue_vs_qpa/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_bogue_vs_qpa/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_bogue_vs_qpa/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=3.221*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=16.250; layer.top=12.000; layer.width=70.000; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 6;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(0,0,0);
set D3a_B -w 350;
layer -i204 D4a_B;
set D4a_B -c color(238,238,238);
set D4a_B -w 250;
set D4a_B -cf color(238,238,238);
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.40398895; layer.x.to=65.532301;
layer.y.from=-0.40398895; layer.y.to=65.532301;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Measured (wt.%)";
xb.fsize=9;
yl.text$="Calculated (wt.%)";
yl.fsize=9;
label -a 63.5542 2.23346 -n T1 x;
T1.text$="mean |difference| = 3.43";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=63.5542+T1.dx/2;
T1.y=2.23346+T1.dy/2;
legend -r;
legend.text$="\l(1) Phases\n\l(2) 1:1";
legend.fsize=8;
legend.background=0;
legend.x=0.980586+legend.dx/2;
legend.y=64.1477-legend.dy/2;
