// Template tga_multi_sample_tg: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_tga_multi_sample_tg/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 500;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_tga_multi_sample_tg/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 500;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_tga_multi_sample_tg/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i200 D4a_B;
set D4a_B -c color(214,39,40);
set D4a_B -w 500;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_tga_multi_sample_tg/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
layer -i200 D5a_B;
set D5a_B -c color(44,160,44);
set D5a_B -w 500;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_tga_multi_sample_tg/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i200 D6a_B;
set D6a_B -c color(148,103,189);
set D6a_B -w 500;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_tga_multi_sample_tg/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
layer -i200 D7a_B;
set D7a_B -c color(255,127,14);
set D7a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-18.5; layer.x.to=1048.5;
layer.y.from=85.797874; layer.y.to=100.67533;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="Mass (%)";
yl.fsize=9;
label -a 1008 86.496 -n T1 x;
T1.text$="86.5";
T1.fsize=6;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=1008+T1.dx/2;
T1.y=86.496-T1.dy/2;
label -a 1008 89.6054 -n T2 x;
T2.text$="89.6";
T2.fsize=6;
T2.color=color(31,119,180);
T2.attach=2;
T2.x=1008+T2.dx/2;
T2.y=89.6054-T2.dy/2;
label -a 1008 90.8022 -n T3 x;
T3.text$="90.8";
T3.fsize=6;
T3.color=color(214,39,40);
T3.attach=2;
T3.x=1008+T3.dx/2;
T3.y=90.8022-T3.dy/2;
label -a 1008 92.0091 -n T4 x;
T4.text$="92.0";
T4.fsize=6;
T4.color=color(44,160,44);
T4.attach=2;
T4.x=1008+T4.dx/2;
T4.y=92.0091-T4.dy/2;
label -a 1008 93.1934 -n T5 x;
T5.text$="93.2";
T5.fsize=6;
T5.color=color(148,103,189);
T5.attach=2;
T5.x=1008+T5.dx/2;
T5.y=93.1934-T5.dy/2;
label -a 1008 94.4145 -n T6 x;
T6.text$="94.4";
T6.fsize=6;
T6.color=color(255,127,14);
T6.attach=2;
T6.x=1008+T6.dx/2;
T6.y=94.4145-T6.dy/2;
legend -r;
legend.text$="\l(1) Sample A\n\l(2) Sample B\n\l(3) Sample C\n\l(4) Sample D\n\l(5) Sample E\n\l(6) Sample F";
legend.fsize=8;
legend.background=0;
legend.x=886.61+legend.dx/2;
legend.y=100.46-legend.dy/2;
