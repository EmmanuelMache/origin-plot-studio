layer.x.type=1;
layer.y.type=1;
layer.x.from=-18.5; layer.x.to=1048.5;
layer.y.from=85.797874; layer.y.to=100.67533;
layer.x.inc=200;
layer.x.minor=3;
layer.y.inc=2;
