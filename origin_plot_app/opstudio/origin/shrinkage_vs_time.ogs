layer -i204 D11a_B;
set D11a_B -c color(255,236,219);
set D11a_B -w 250;
set D11a_B -cf color(255,236,219);
layer.x.type=1;
layer.y.type=1;
layer.x.from=-3.45; layer.x.to=94.45;
layer.y.from=-898.23875; layer.y.to=38.30796;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Drying time (days)";
xb.fsize=9;
yl.text$="Drying shrinkage (µm m\+(-1))";
yl.fsize=9;
win -t data origin L12a;
win -a L12a; impASC fname:="<data folder>/data_for_origin/demo_shrinkage_vs_time/L12a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L12a]1!;
win -a L12a;
layer -i200 L12a_B;
set L12a_B -c color(0,0,0);
set L12a_B -w 250;
legend -r;
legend.text$="\l(1) Sample B\n\l(2) Sample C\n\l(3) Sample D\n\l(4) Sample E\n\l(5) Sample F";
legend.fsize=8;
legend.background=0;
legend.x=-2.57045+legend.dx/2;
legend.y=-672.194-legend.dy/2;
