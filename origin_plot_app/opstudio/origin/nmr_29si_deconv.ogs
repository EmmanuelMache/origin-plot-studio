win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=60.098;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=73.976; layer.width=77.500; layer.height=15.024;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 400;
layer -i200 D3a_B;
set D3a_B -c color(192,20,30);
set D3a_B -w 450;
set D3a_B -d 1;
layer -i204 D4a_B;
set D4a_B -c color(177,207,229);
set D4a_B -w 250;
set D4a_B -cf color(177,207,229);
layer -i204 D5a_B;
set D5a_B -c color(241,179,180);
set D5a_B -w 250;
set D5a_B -cf color(241,179,180);
layer -i204 D6a_B;
set D6a_B -c color(181,222,181);
set D6a_B -w 250;
set D6a_B -cf color(181,222,181);
layer -i204 D7a_B;
set D7a_B -c color(218,202,232);
set D7a_B -w 250;
set D7a_B -cf color(218,202,232);
layer.x.type=1;
layer.y.type=1;
layer.x.from=-60; layer.x.to=-110;
layer.y.from=-0.10338135; layer.y.to=1.1272612;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Intensity (a.u.)";
yl.fsize=9;
legend -r;
legend.text$="\l(1) Observed\n\l(2) Fit";
legend.fsize=8;
legend.background=0;
legend.x=-95.4061+legend.dx/2;
legend.y=1.10445-legend.dy/2;
win -a d1a;
page.active=2;
layer -i200 D8a_B;
set D8a_B -c color(85,85,85);
set D8a_B -w 250;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-60; layer.x.to=-110;
layer.y.from=-0.05821871; layer.y.to=0.05148727;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="\+(29)Si chemical shift (ppm)";
xb.fsize=9;
yl.text$="Res.";
yl.fsize=9;
