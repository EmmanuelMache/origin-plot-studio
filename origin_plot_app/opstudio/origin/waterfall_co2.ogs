// Template waterfall_co2: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_waterfall_co2/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_waterfall_co2/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_waterfall_co2/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_waterfall_co2/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_waterfall_co2/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -a d1a;
page.active=1;
layer -i203 D2a_B;
set D2a_B -c color(23,50,77);
set D2a_B -w 250;
set D2a_B -cf color(23,50,77);
set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
set D2a_B -w 200;
win -a d1a;
page.active=1;
layer -i203 D3a_B;
set D3a_B -c color(21,128,61);
set D3a_B -w 250;
set D3a_B -cf color(21,128,61);
set D3a_B -c color(0,0,0);
set D3a_B -w 250;
set D3a_B -z 6;
set D3a_B -w 200;
win -a d1a;
page.active=1;
layer -i203 D4a_B;
set D4a_B -c color(21,128,61);
set D4a_B -w 250;
set D4a_B -cf color(21,128,61);
set D4a_B -c color(0,0,0);
set D4a_B -w 250;
set D4a_B -z 6;
set D4a_B -w 200;
win -a d1a;
page.active=1;
layer -i203 D5a_B;
set D5a_B -c color(21,128,61);
set D5a_B -w 250;
set D5a_B -cf color(21,128,61);
set D5a_B -c color(0,0,0);
set D5a_B -w 250;
set D5a_B -z 6;
set D5a_B -w 200;
win -a d1a;
page.active=1;
layer -i203 D6a_B;
set D6a_B -c color(23,50,77);
set D6a_B -w 250;
set D6a_B -cf color(23,50,77);
set D6a_B -c color(0,0,0);
set D6a_B -w 250;
set D6a_B -z 6;
set D6a_B -w 200;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.64; layer.x.to=4.64;
layer.y.from=0; layer.y.to=870;
layer.x.inc=1;
layer.x.minor=0;
layer.y.inc=100;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
layer.x.label.color=color(255,255,255);
layer.x.label.pt=4;
layer.x.minor=0;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0 435 -n T1 x;
T1.text$="CO\-(2) (kg t\+(-1))";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.rotate=90;
T1.x=-0.964098;
T1.y=435;
label -a 0 0 -n T2 x;
T2.text$="Reference";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=0;
T2.y=-14.3326-T2.dy/2;
label -a 1 0 -n T3 x;
T3.text$="Replace raw material";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=1;
T3.y=-14.3326-T3.dy/2;
label -a 2 0 -n T4 x;
T4.text$="Lower kiln T";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=2;
T4.y=-14.3326-T4.dy/2;
label -a 3 0 -n T5 x;
T5.text$="Fuel switch";
T5.fsize=6;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=3;
T5.y=-14.3326-T5.dy/2;
