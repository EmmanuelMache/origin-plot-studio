win -a D10a;
layer -i200 D10a_B;
set D10a_B -c color(44,160,44);
set D10a_B -w 400;
set D10a_B -d 1;
layer.x.type=2;
layer.y.type=2;
layer.x.from=0.066834392; layer.x.to=473.15126;
layer.y.from=0.30299075; layer.y.to=348.82678;
layer.link=1;
