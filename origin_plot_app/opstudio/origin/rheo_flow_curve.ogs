win -a D5a;
layer -i200 D5a_B;
set D5a_B -c color(214,39,40);
set D5a_B -w 500;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i201 D6a_B;
set D6a_B -c color(44,160,44);
set D6a_B -k 2;
set D6a_B -z 5;
set D6a_B -kf 1;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
layer -i200 D7a_B;
set D7a_B -c color(44,160,44);
set D7a_B -w 500;
layer.x.type=2;
layer.y.type=2;
layer.x.from=0.066834392; layer.x.to=473.15126;
layer.y.from=5.1829668; layer.y.to=195.85006;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Shear rate (s\+(-1))";
xb.fsize=9;
yl.text$="Shear stress (Pa)";
yl.fsize=9;
legend -r;
legend.text$="\l(2) Paste 1: τ\-(0) = 12.0 Pa\n\l(4) Paste 2: τ\-(0) = 25.0 Pa\n\l(6) Paste 3: τ\-(0) = 6.0 Pa";
legend.fsize=8;
legend.background=0;
legend.x=56.8041+legend.dx/2;
legend.y=9.07003-legend.dy/2;
