layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.5; layer.x.to=10.5;
layer.y.from=-0.14839648; layer.y.to=3.1499236;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="x (unit)";
xb.fsize=9;
yl.text$="y (unit)";
yl.fsize=9;
win -a d1a;
page.active=2;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0; layer.x.to=1;
layer.y.from=20; layer.y.to=200;
layer.x.showAxes=1;
layer.y.showAxes=1;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=0;
layer.y2.ticks=0;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
