// Template colormap_line_series: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=65.100; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=78.375; layer.top=12.000; layer.width=2.406; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_colormap_line_series/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(68,1,84);
set D2a_B -w 500;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_colormap_line_series/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
