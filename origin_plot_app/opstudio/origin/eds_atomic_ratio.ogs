// Template eds_atomic_ratio: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_eds_atomic_ratio/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_eds_atomic_ratio/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_eds_atomic_ratio/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_eds_atomic_ratio/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_eds_atomic_ratio/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.835*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -k 2;
set D2a_B -z 3;
layer -i201 D3a_B;
set D3a_B -c color(255,127,14);
set D3a_B -k 2;
set D3a_B -z 3;
layer -i201 D4a_B;
set D4a_B -c color(0,0,0);
set D4a_B -k 8;
set D4a_B -z 6;
layer -i201 D5a_B;
set D5a_B -c color(0,0,0);
set D5a_B -k 8;
set D5a_B -z 6;
layer -i201 D6a_B;
set D6a_B -c color(0,0,0);
set D6a_B -k 8;
set D6a_B -z 6;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.02; layer.x.to=0.94229516;
layer.y.from=-0.02; layer.y.to=0.525;
layer.x.inc=0.2;
layer.x.minor=4;
layer.y.inc=0.1;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.461148 0 -n T1 x;
T1.text$="Si/Ca (atomic ratio)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.461148;
T1.y=-0.0893593;
label -a 0 0.2525 -n T2 x;
T2.text$="Al/Ca (atomic ratio)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-0.132137;
T2.y=0.2525;
label -a 3.82918 1.07 -n T3 x;
T3.text$="CH";
T3.fsize=5;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=3.82918+T3.dx/2;
T3.y=1.07+T3.dy/2;
label -a 3.82918 1.07 -n T4 x;
T4.text$="AFt";
T4.fsize=5;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=3.82918+T4.dx/2;
T4.y=1.07+T4.dy/2;
