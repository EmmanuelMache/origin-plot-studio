// Template dsc_heatflow: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_dsc_heatflow/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-18.5; layer.x.to=1048.5;
layer.y.from=-1.2447598; layer.y.to=0.73027335;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="Heat flow (W g\+(-1))";
yl.fsize=9;
label -a 40.185 0.374767 -n T1 x;
T1.text$="exo ↑";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=40.185+T1.dx/2;
T1.y=0.374767+T1.dy/2;
