// Template error_band: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_error_band/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_error_band/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 500;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_error_band/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i200 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 500;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_error_band/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
layer -i204 D5a_B;
set D5a_B -c color(215,231,242);
set D5a_B -w 250;
set D5a_B -cf color(215,231,242);
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_error_band/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i204 D6a_B;
set D6a_B -c color(248,216,216);
set D6a_B -w 250;
set D6a_B -cf color(248,216,216);
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_error_band/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
layer -i204 D7a_B;
set D7a_B -c color(217,238,217);
set D7a_B -w 250;
set D7a_B -cf color(217,238,217);
layer.x.type=1;
layer.y.type=1;
layer.x.from=-1.4; layer.x.to=29.4;
layer.y.from=-1.7958528; layer.y.to=24.512909;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Age (days)";
xb.fsize=9;
yl.text$="Response (unit)";
yl.fsize=9;
legend -r;
legend.text$="\l(1) Group 1\n\l(2) Group 2\n\l(3) Group 3";
legend.fsize=8;
legend.background=0;
legend.x=-1.12329+legend.dx/2;
legend.y=24.1323-legend.dy/2;
