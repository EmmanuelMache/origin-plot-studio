// Template eis_nyquist: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_eis_nyquist/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i202 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
set D2a_B -k 2;
set D2a_B -z 5;
set D2a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-35.506967; layer.x.to=495.60192;
layer.y.from=-14.796108; layer.y.to=315.00538;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Z′ (Ω)";
xb.fsize=9;
yl.text$="−Z″ (Ω)";
yl.fsize=9;
label -a 2088.93 1304.41 -n T1 x;
T1.text$="0.0044 Hz";
T1.fsize=6;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=2088.93+T1.dx/2;
T1.y=1304.41+T1.dy/2;
label -a 2088.93 1304.41 -n T2 x;
T2.text$="0.14 Hz";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=2088.93+T2.dx/2;
T2.y=1304.41+T2.dy/2;
label -a 2088.93 1304.41 -n T3 x;
T3.text$="5.6 Hz";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=2088.93+T3.dx/2;
T3.y=1304.41+T3.dy/2;
label -a 2088.93 1304.41 -n T4 x;
T4.text$="1.8e+02 Hz";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=2088.93+T4.dx/2;
T4.y=1304.41+T4.dy/2;
label -a 2088.93 1304.41 -n T5 x;
T5.text$="7e+03 Hz";
T5.fsize=6;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=2088.93+T5.dx/2;
T5.y=1304.41+T5.dy/2;
