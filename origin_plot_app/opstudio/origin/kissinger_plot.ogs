// Template kissinger_plot: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_kissinger_plot/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_kissinger_plot/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.625*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 4;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(192,20,30);
set D3a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0.99156089; layer.x.to=1.0997477;
layer.y.from=-13.047727; layer.y.to=-10.719768;
layer.x.inc=0.02;
layer.x.minor=4;
layer.y.inc=0.5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 1.04565 0 -n T1 x;
T1.text$="1000/T\-(p) (K\+(-1))";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=1.04565;
T1.y=-13.384;
label -a 0.973011 0 -n T2 x;
T2.text$="ln(β/T\-(p)\+(2))";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=0.973011;
T2.y=-11.8837;
win -a d1a;
page.active=1;
label -a 1.05282 0 -n T3 x;
T3.text$="\l(2) E\-(a) = 179 kJ mol\+(-1)";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=1.05282+T3.dx/2;
T3.y=-10.8959;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0.99156089; layer.x.to=1.0997477;
layer.y.from=-13.047727; layer.y.to=-10.719768;
layer.x.inc=0.02;
layer.x.minor=4;
layer.y.inc=0.5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
