// Template grouped_hatched_bars_markers: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 5;
set D2a_B -z 8;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -a d1a;
page.active=1;
layer -i203 D3a_B;
set D3a_B -c color(85,85,85);
set D3a_B -w 250;
set D3a_B -cf color(85,85,85);
set D3a_B -c color(0,0,0);
set D3a_B -w 250;
set D3a_B -z 6;
layer.bar.gap=80;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -a d1a;
page.active=1;
layer -i203 D4a_B;
set D4a_B -c color(230,168,0);
set D4a_B -w 250;
set D4a_B -cf color(230,168,0);
set D4a_B -c color(0,0,0);
set D4a_B -w 250;
set D4a_B -z 6;
set D4a_B -pfv 1;
layer.bar.gap=80;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -a d1a;
page.active=1;
layer -i203 D5a_B;
set D5a_B -c color(93,173,226);
set D5a_B -w 250;
set D5a_B -cf color(93,173,226);
set D5a_B -c color(0,0,0);
set D5a_B -w 250;
set D5a_B -z 6;
set D5a_B -pfv 2;
layer.bar.gap=80;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -a d1a;
page.active=1;
layer -i203 D6a_B;
set D6a_B -c color(211,84,0);
set D6a_B -w 250;
set D6a_B -cf color(211,84,0);
set D6a_B -c color(0,0,0);
set D6a_B -w 250;
set D6a_B -z 6;
set D6a_B -pfv 6;
layer.bar.gap=80;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.64; layer.x.to=4.64;
layer.y.from=0; layer.y.to=64.05;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Sample (additive, wt.%)";
xb.fsize=9;
yl.text$="Liquid or amorphous (wt.%)";
yl.fsize=9;
label -a 0 0 -n T1 x;
T1.text$="Sample B\n(0)";
T1.fsize=8;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0;
T1.y=0-T1.dy/2;
label -a 1 0 -n T2 x;
T2.text$="Sample C\n(5)";
T2.fsize=8;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=1;
T2.y=0-T2.dy/2;
label -a 2 0 -n T3 x;
T3.text$="Sample D\n(10)";
T3.fsize=8;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=2;
T3.y=0-T3.dy/2;
label -a 3 0 -n T4 x;
T4.text$="Sample E\n(15)";
T4.fsize=8;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=3;
T4.y=0-T4.dy/2;
label -a 4 0 -n T5 x;
T5.text$="Sample F\n(20)";
T5.fsize=8;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=4;
T5.y=0-T5.dy/2;
layer.x.showLabels=0;
label -a -0.64 64.05 -n T6 x;
T6.text$="\b((a) Liquid at 1400 °C)";
T6.fsize=9;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=-0.64+T6.dx/2;
T6.y=64.05+T6.dy/2;
legend -r;
legend.text$="\l(1) Rietveld (amorphous)\n\l(2) All oxides\n\l(3) Without Na\-(2)O\n\l(4) Without K\-(2)O\n\l(5) Without Na\-(2)O and K\-(2)O";
legend.fsize=6;
legend.background=0;
legend.x=-0.598889+legend.dx/2;
legend.y=63.2469-legend.dy/2;
