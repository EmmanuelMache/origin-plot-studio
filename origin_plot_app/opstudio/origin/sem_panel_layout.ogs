// Template sem_panel_layout: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin B2a;
win -a B2a; impASC fname:="<data folder>/data_for_origin/demo_sem_panel_layout/B2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B2a]1!;
