// Template free_lime_bar: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_free_lime_bar/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_free_lime_bar/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_free_lime_bar/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -a d1a;
page.active=1;
layer -i203 D2a_B;
set D2a_B -c color(31,110,140);
set D2a_B -w 250;
set D2a_B -cf color(31,110,140);
set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
set D2a_B -w 200;
layer -i201 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -k 9;
set D3a_B -z 5;
layer -i201 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -k 9;
set D4a_B -z 5;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.58; layer.x.to=5.58;
layer.y.from=0; layer.y.to=0.8715;
layer.x.inc=1;
layer.x.minor=0;
layer.y.inc=0.1;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
layer.x.label.color=color(255,255,255);
layer.x.label.pt=4;
layer.x.minor=0;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0 0.43575 -n T1 x;
T1.text$="f-CaO (wt.%)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.rotate=90;
T1.x=-0.920024;
T1.y=0.43575;
label -a 0 0 -n T2 x;
T2.text$="Sample A";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=0;
T2.y=-0.0151979-T2.dy/2;
label -a 1 0 -n T3 x;
T3.text$="Sample B";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=1;
T3.y=-0.0151979-T3.dy/2;
