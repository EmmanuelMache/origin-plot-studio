T7.attach=2;
T7.x=5;
T7.y=-0.0151979-T7.dy/2;
label -a 5 0.0079 -n T8 x;
T8.text$="n.d.";
T8.fsize=6;
T8.color=color(0,0,0);
T8.attach=2;
T8.x=5;
T8.y=0.0079+T8.dy/2;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.58; layer.x.to=5.58;
layer.y.from=0; layer.y.to=0.8715;
layer.x.inc=1;
