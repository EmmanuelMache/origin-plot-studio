// Template broken_axis: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=18.689;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=32.932; layer.width=77.500; layer.height=56.068;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 300;
layer.x.type=1;
layer.y.type=1;
layer.x.from=7.5; layer.x.to=62.5;
layer.y.from=14000; layer.y.to=16624.427;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.show=0;
win -a d1a;
page.active=2;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(0,0,0);
set D3a_B -w 300;
layer.x.type=1;
layer.y.type=1;
layer.x.from=7.5; layer.x.to=62.5;
layer.y.from=0; layer.y.to=2500;
layer.x.showAxes=1;
layer.y.showAxes=1;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=0;
layer.y2.ticks=0;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="2θ (°), Cu Kα";
xb.fsize=9;
yl.text$="Counts";
yl.fsize=9;
