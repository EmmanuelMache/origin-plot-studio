set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
set D2a_B -w 200;
layer -i201 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -k 9;
set D3a_B -z 4;
layer -i201 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -k 9;
set D4a_B -z 4;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.69; layer.x.to=5.69;
layer.y.from=0; layer.y.to=194.25;
layer.x.inc=1;
layer.x.minor=0;
layer.y.inc=25;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
layer.x.label.color=color(255,255,255);
layer.x.label.pt=4;
layer.x.minor=0;
