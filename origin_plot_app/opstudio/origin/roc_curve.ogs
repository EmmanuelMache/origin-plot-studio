// Template roc_curve: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_roc_curve/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_roc_curve/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_roc_curve/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.953*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=19.167; layer.top=12.000; layer.width=64.167; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 483;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 483;
layer -i200 D4a_B;
set D4a_B -c color(136,136,136);
set D4a_B -w 483;
set D4a_B -d 2;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.05; layer.x.to=1.05;
layer.y.from=-0.05; layer.y.to=1.05;
layer.x.inc=0.25;
layer.x.minor=4;
layer.y.inc=0.2;
layer.y.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.773;
layer.y.thickness=0.773;
layer.x2.thickness=0.773;
layer.y2.thickness=0.773;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.5 0 -n T1 x;
T1.text$="False positive rate";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.5;
T1.y=-0.184392;
label -a 0 0.5 -n T2 x;
T2.text$="True positive rate";
T2.fsize=9;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-0.204819;
T2.y=0.5;
win -a d1a;
page.active=1;
label -a 0.296265 0.0967733 -n T3 x;
T3.text$="\l(1) Classifier A (AUC = 0.79)";
T3.fsize=7;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=0.296265+T3.dx/2;
T3.y=0.0967733;
label -a 0.296265 0.020763 -n T4 x;
T4.text$="\l(2) Classifier B (AUC = 0.74)";
T4.fsize=7;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=0.296265+T4.dx/2;
T4.y=0.020763;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-0.05; layer.x.to=1.05;
layer.y.from=-0.05; layer.y.to=1.05;
layer.x.inc=0.25;
layer.x.minor=4;
layer.y.inc=0.2;
layer.y.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.773;
layer.y.thickness=0.773;
layer.x2.thickness=0.773;
layer.y2.thickness=0.773;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
