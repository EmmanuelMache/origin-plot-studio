// Template tangent_method_demo: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin B2a;
win -a B2a; impASC fname:="<data folder>/data_for_origin/demo_tangent_method_demo/B2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[B2a]1!;
win -a B2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_tangent_method_demo/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_tangent_method_demo/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_tangent_method_demo/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -a d1a;
page.active=1;
layer -i204 B2a_B;
set B2a_B -c color(252,238,226);
set B2a_B -w 100;
set B2a_B -cf color(252,238,226);
set B2a_B -c color(0,0,0);
set B2a_B -w 250;
set B2a_B -z 6;
set B2a_B -pf 1;
layer -i200 D3a_B;
set D3a_B -c color(0,0,0);
set D3a_B -w 500;
layer -i200 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -w 400;
set D4a_B -d 1;
layer -i200 D5a_B;
set D5a_B -c color(31,119,180);
set D5a_B -w 400;
set D5a_B -d 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=305.08139; layer.x.to=645.32555;
layer.y.from=88.80264; layer.y.to=92.72737;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="Mass (%)";
yl.fsize=9;
label -a 478.027 90.7644 -n T1 x;
T1.text$="Δm = 3.50 %";
T1.fsize=8;
T1.color=color(192,20,30);
T1.attach=2;
T1.x=478.027+T1.dx/2;
T1.y=90.7644+T1.dy/2;
