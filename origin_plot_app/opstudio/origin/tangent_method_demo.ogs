page.active=1;
layer -i204 B2a_B;
set B2a_B -c color(252,238,226);
set B2a_B -w 100;
set B2a_B -cf color(252,238,226);
set B2a_B -c color(0,0,0);
set B2a_B -w 250;
set B2a_B -z 6;
set B2a_B -pf 1;
layer -i200 D3a_B;
set D3a_B -c color(0,0,0);
set D3a_B -w 400;
layer -i200 D4a_B;
set D4a_B -c color(31,119,180);
set D4a_B -w 320;
set D4a_B -d 1;
layer -i200 D5a_B;
set D5a_B -c color(31,119,180);
set D5a_B -w 320;
set D5a_B -d 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=305.08139; layer.x.to=645.32555;
layer.y.from=88.80264; layer.y.to=92.72737;
layer.x.inc=50;
layer.x.minor=6;
layer.y.inc=0.5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
