// Template xrd_single_labeled: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_xrd_single_labeled/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 320;
layer.x.type=1;
layer.y.type=1;
layer.x.from=10; layer.x.to=60;
layer.y.from=0; layer.y.to=2100.2088;
layer.x.inc=10;
layer.x.minor=4;
layer.y.inc=250;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 35 0 -n T1 x;
T1.text$="2θ (°), Cu Kα";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=35;
T1.y=-162.058;
label -a 6.49259 1050.1 -n T2 x;
T2.text$="Intensity (counts)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=6.49259;
T2.y=1050.1;
