win -a D6a;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_mip_pore/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=33.696; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=56.304; layer.top=12.000; layer.width=33.696; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 920;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 920;
layer -i200 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 920;
layer.x.type=2;
layer.y.type=1;
layer.x.from=177.82794; layer.x.to=0.00056234133;
layer.y.from=-0.0089999994; layer.y.to=0.18899999;
layer.y.inc=0.025;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=15; layer.y.label.pt=15;
layer.y2.label.pt=15;
layer.x.thickness=1.47;
layer.y.thickness=1.47;
layer.x2.thickness=1.47;
layer.y2.thickness=1.47;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.316228 0 -n T1 x;
T1.text$="Pore entry diameter (µm)";
T1.fsize=17;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.316228;
T1.y=-0.0255019;
