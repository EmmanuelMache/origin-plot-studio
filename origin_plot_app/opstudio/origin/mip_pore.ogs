// Template mip_pore: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=33.696; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=56.304; layer.top=12.000; layer.width=33.696; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 500;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 500;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
layer -i200 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -w 500;
layer.x.type=2;
layer.y.type=1;
layer.x.from=177.82794; layer.x.to=0.00056234133;
layer.y.from=-0.0089999994; layer.y.to=0.18899999;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Pore entry diameter (µm)";
xb.fsize=9;
yl.text$="Cumulative intrusion (mL g\+(-1))";
yl.fsize=9;
label -a 177.828 0.189 -n T1 x;
T1.text$="\b((a))";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=177.828+T1.dx/2;
T1.y=0.189+T1.dy/2;
legend -r;
legend.text$="\l(1) Sample B 28 d\n\l(2) Sample D 28 d\n\l(3) Sample F 28 d";
legend.fsize=8;
legend.background=0;
legend.x=136.883+legend.dx/2;
legend.y=0.186135-legend.dy/2;
win -a d1a;
page.active=2;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
layer -i200 D5a_B;
set D5a_B -c color(31,119,180);
set D5a_B -w 500;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
layer -i200 D6a_B;
set D6a_B -c color(214,39,40);
set D6a_B -w 500;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
layer -i200 D7a_B;
set D7a_B -c color(44,160,44);
set D7a_B -w 500;
layer.x.type=2;
layer.y.type=1;
layer.x.from=177.82794; layer.x.to=0.00056234133;
layer.y.from=-0.0170108; layer.y.to=0.3572268;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Pore entry diameter (µm)";
xb.fsize=9;
yl.text$="Log differential intrusion (mL g\+(-1))";
yl.fsize=9;
label -a 177.828 0.357227 -n T2 x;
T2.text$="\b((b))";
T2.fsize=9;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=177.828+T2.dx/2;
T2.y=0.357227+T2.dy/2;
