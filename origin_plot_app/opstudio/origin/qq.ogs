// Template qq: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_qq/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_qq/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.726*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 3;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(192,20,30);
set D3a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-3.198107; layer.x.to=3.198107;
layer.y.from=30.339952; layer.y.to=74.195797;
layer.x.inc=2;
layer.x.minor=5;
layer.y.inc=10;
layer.y.minor=6;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0 24.5354 -n T1 x;
T1.text$="Theoretical quantiles";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=-8.88178e-16;
T1.y=24.5354;
label -a 0 52.2679 -n T2 x;
T2.text$="Sample quantiles";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-3.86582;
T2.y=52.2679;
win -a d1a;
page.active=1;
label -a 0 71.1394 -n T3 x;
T3.text$="\l(2) r = 0.988";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=-2.97974+T3.dx/2;
T3.y=71.1394;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-3.198107; layer.x.to=3.198107;
layer.y.from=30.339952; layer.y.to=74.195797;
layer.x.inc=2;
layer.x.minor=5;
layer.y.inc=10;
layer.y.minor=6;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
