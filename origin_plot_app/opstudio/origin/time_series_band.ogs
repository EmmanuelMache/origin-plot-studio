// Template time_series_band: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_time_series_band/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_time_series_band/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_time_series_band/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(187,187,187);
set D2a_B -w 200;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 560;
layer -i204 D4a_B;
set D4a_B -c color(221,235,244);
set D4a_B -w 200;
set D4a_B -cf color(221,235,244);
layer.x.type=1;
layer.y.type=1;
layer.x.from=-36.45; layer.x.to=765.45;
layer.y.from=-5.4695683; layer.y.to=25.318918;
layer.x.inc=100;
layer.x.minor=5;
layer.y.inc=5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 364.5 0 -n T1 x;
T1.text$="Day";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=364.5;
T1.y=-7.84529;
label -a 0 9.92467 -n T2 x;
T2.text$="Temperature (°C)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-77.0251;
T2.y=9.92467;
win -a d1a;
page.active=1;
label -a 362.984 24.068 -n T3 x;
T3.text$="\l(1) Raw";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=362.984+T3.dx/2;
T3.y=24.068;
label -a 459.696 24.068 -n T4 x;
T4.text$="\l(3) 30-point range";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=459.696+T4.dx/2;
T4.y=24.068;
label -a 620.959 24.068 -n T5 x;
T5.text$="\l(2) 30-point mean";
T5.fsize=6;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=620.959+T5.dx/2;
T5.y=24.068;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-36.45; layer.x.to=765.45;
layer.y.from=-5.4695683; layer.y.to=25.318918;
layer.x.inc=100;
layer.x.minor=5;
layer.y.inc=5;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
