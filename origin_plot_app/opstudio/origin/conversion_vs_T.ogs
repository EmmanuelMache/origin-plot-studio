// Template conversion_vs_T: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_conversion_vs_T/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_conversion_vs_T/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_conversion_vs_T/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_conversion_vs_T/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(13,8,135);
set D2a_B -w 400;
layer -i200 D3a_B;
set D3a_B -c color(126,3,168);
set D3a_B -w 400;
layer -i200 D4a_B;
set D4a_B -c color(204,71,120);
set D4a_B -w 400;
layer -i200 D5a_B;
set D5a_B -c color(248,149,64);
set D5a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=470; layer.x.to=1130;
layer.y.from=-0.049963735; layer.y.to=1.0499983;
layer.x.inc=100;
layer.x.minor=4;
layer.y.inc=0.2;
layer.y.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 800 0 -n T1 x;
T1.text$="Temperature (°C)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=800;
T1.y=-0.13484;
label -a 433.569 0.500017 -n T2 x;
T2.text$="Conversion α (–)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=433.569;
T2.y=0.500017;
win -a d1a;
page.active=1;
label -a 480.673 1.00302 -n T3 x;
T3.text$="\l(1) β = 2 °C min\+(-1)";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=480.673+T3.dx/2;
T3.y=1.00302;
label -a 480.673 0.950439 -n T4 x;
T4.text$="\l(2) β = 5 °C min\+(-1)";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=480.673+T4.dx/2;
T4.y=0.950439;
label -a 480.673 0.897858 -n T5 x;
T5.text$="\l(3) β = 10 °C min\+(-1)";
T5.fsize=6;
T5.color=color(0,0,0);
T5.attach=2;
T5.x=480.673+T5.dx/2;
T5.y=0.897858;
label -a 480.673 0.845278 -n T6 x;
T6.text$="\l(4) β = 20 °C min\+(-1)";
T6.fsize=6;
T6.color=color(0,0,0);
T6.attach=2;
T6.x=480.673+T6.dx/2;
T6.y=0.845278;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=470; layer.x.to=1130;
layer.y.from=-0.049963735; layer.y.to=1.0499983;
layer.x.inc=100;
layer.x.minor=4;
layer.y.inc=0.2;
layer.y.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
