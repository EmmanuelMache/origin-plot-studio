// Template abrams_wc_strength: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_abrams_wc_strength/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_abrams_wc_strength/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.625*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 4;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 400;
set D3a_B -d 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0.3375; layer.x.to=0.6125;
layer.y.from=33.917201; layer.y.to=59.397977;
layer.x.inc=0.05;
layer.x.minor=4;
layer.y.inc=5;
layer.y.minor=5;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0.475 30.415 -n T1 x;
T1.text$="w/c ratio (–)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=0.475;
T1.y=30.415;
label -a 0.308792 46.6576 -n T2 x;
T2.text$="28-d compressive strength (MPa)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=0.308792;
T2.y=46.6576;
win -a d1a;
page.active=1;
label -a 0.507113 57.5539 -n T3 x;
T3.text$="\l(1) Measured";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=0.507113+T3.dx/2;
T3.y=57.5539;
label -a 0.509895 55.447 -n T4 x;
T4.text$="\l(2) f = 112 / 7.0\+(w/c)";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=0.509895+T4.dx/2;
T4.y=55.447;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=0.3375; layer.x.to=0.6125;
layer.y.from=33.917201; layer.y.to=59.397977;
layer.x.inc=0.05;
layer.x.minor=4;
layer.y.inc=5;
layer.y.minor=5;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
