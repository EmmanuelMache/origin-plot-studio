// Template sensitivity_tornado: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_sensitivity_tornado/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_sensitivity_tornado/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin L4a;
win -a L4a; impASC fname:="<data folder>/data_for_origin/demo_sensitivity_tornado/L4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L4a]1!;
win -a L4a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -a d1a;
page.active=1;
layer -i203 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -w 250;
set D2a_B -cf color(31,119,180);
set D2a_B -c color(0,0,0);
set D2a_B -w 250;
set D2a_B -z 6;
set D2a_B -w 200;
win -a d1a;
page.active=1;
layer -i203 D3a_B;
set D3a_B -c color(214,39,40);
set D3a_B -w 250;
set D3a_B -cf color(214,39,40);
set D3a_B -c color(0,0,0);
set D3a_B -w 250;
set D3a_B -z 6;
set D3a_B -w 200;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-19.65; layer.x.to=16.65;
layer.y.from=-0.64; layer.y.to=4.64;
layer.x.inc=5;
layer.x.minor=5;
layer.y.inc=1;
layer.y.minor=0;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 0 0 -n T1 x;
T1.text$="Change in result (%)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=-1.5;
T1.y=-1.04742;
layer -i200 L4a_B;
set L4a_B -c color(0,0,0);
set L4a_B -w 320;
win -a d1a;
page.active=1;
label -a 10.8189 0 -n T2 x;
T2.text$="\l(1) Low setting";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=10.8189+T2.dx/2;
T2.y=-0.195045;
label -a 10.8189 0 -n T3 x;
T3.text$="\l(2) High setting";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=10.8189+T3.dx/2;
T3.y=-0.425476;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-19.65; layer.x.to=16.65;
layer.y.from=-0.64; layer.y.to=4.64;
layer.x.inc=5;
layer.x.minor=5;
layer.y.inc=1;
layer.y.minor=0;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
