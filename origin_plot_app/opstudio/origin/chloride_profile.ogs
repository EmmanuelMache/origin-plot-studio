// Template chloride_profile: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_chloride_profile/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_chloride_profile/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t data origin D4a;
win -a D4a; impASC fname:="<data folder>/data_for_origin/demo_chloride_profile/D4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D4a]1!;
win -a D4a;
win -t data origin D5a;
win -a D5a; impASC fname:="<data folder>/data_for_origin/demo_chloride_profile/D5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D5a]1!;
win -a D5a;
win -t data origin D6a;
win -a D6a; impASC fname:="<data folder>/data_for_origin/demo_chloride_profile/D6a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D6a]1!;
win -a D6a;
win -t data origin D7a;
win -a D7a; impASC fname:="<data folder>/data_for_origin/demo_chloride_profile/D7a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D7a]1!;
win -a D7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(31,119,180);
set D2a_B -k 2;
set D2a_B -z 4;
set D2a_B -kf 1;
layer -i200 D3a_B;
set D3a_B -c color(31,119,180);
set D3a_B -w 400;
layer -i201 D4a_B;
set D4a_B -c color(44,160,44);
set D4a_B -k 2;
set D4a_B -z 4;
set D4a_B -kf 1;
layer -i200 D5a_B;
set D5a_B -c color(44,160,44);
set D5a_B -w 400;
layer -i201 D6a_B;
set D6a_B -c color(255,127,14);
set D6a_B -k 2;
set D6a_B -z 4;
set D6a_B -kf 1;
layer -i200 D7a_B;
set D7a_B -c color(255,127,14);
set D7a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-1.5; layer.x.to=31.5;
layer.y.from=-0.014895195; layer.y.to=0.97499501;
layer.x.inc=5;
layer.x.minor=4;
layer.y.inc=0.2;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 15 0 -n T1 x;
T1.text$="Depth (mm)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=15;
T1.y=-0.0912777;
