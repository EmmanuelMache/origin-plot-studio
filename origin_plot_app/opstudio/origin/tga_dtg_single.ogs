// Template tga_dtg_single: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_tga_dtg_single/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=30; layer.x.to=1000;
layer.y.from=87.793614; layer.y.to=100.50961;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="Mass (%)";
yl.fsize=9;
label -a 9730 316.682 -n T1 x;
T1.text$="Δm = 7.22 %\n30–200 °C";
T1.fsize=6;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=9730+T1.dx/2;
T1.y=316.682+T1.dy/2;
label -a 9730 316.682 -n T2 x;
T2.text$="Δm = 3.51 %\n400–550 °C";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=9730+T2.dx/2;
T2.y=316.682+T2.dy/2;
legend -r;
legend.text$="\l(1) TG (mass)";
legend.fsize=8;
legend.background=0;
legend.x=38.7146+legend.dx/2;
legend.y=89.1979-legend.dy/2;
win -a d1a;
page.active=2;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_tga_dtg_single/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
layer -i200 D3a_B;
set D3a_B -c color(192,20,30);
set D3a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=30; layer.x.to=1000;
layer.y.from=-0.094682567; layer.y.to=0.0057359423;
layer.link=1;
layer.x.link=1;
layer.x.showAxes=0;
layer.y.showAxes=2;
layer.y.showLabels=0;
layer.y2.showLabels=1;
layer.y2.ticks=5;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yr.text$="DTG (% °C\+(-1))";
yr.fsize=9;
yr.color=color(192,20,30);
