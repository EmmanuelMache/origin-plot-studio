// Template tga_dtg_single: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_tga_dtg_single/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin D3a;
win -a D3a; impASC fname:="<data folder>/data_for_origin/demo_tga_dtg_single/D3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D3a]1!;
win -a D3a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 400;
layer.x.type=1;
layer.y.type=1;
layer.x.from=30; layer.x.to=1000;
layer.y.from=87.793614; layer.y.to=100.50961;
layer.x.inc=200;
layer.x.minor=4;
layer.y.inc=2;
layer.y.minor=3;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 515 86.8124 -n T1 x;
T1.text$="Temperature (°C)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=515;
T1.y=86.8124;
label -a 0 94.1516 -n T2 x;
T2.text$="Mass (%)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=-28.0046;
T2.y=94.1516;
label -a 9730 317.071 -n T3 x;
T3.text$="Δm = 7.22 %";
T3.fsize=5;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=9730+T3.dx/2;
T3.y=317.071+T3.dy/2;
label -a 9730 316.682 -n T4 x;
T4.text$="30–200 °C";
T4.fsize=5;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=9730+T4.dx/2;
T4.y=316.682+T4.dy/2;
