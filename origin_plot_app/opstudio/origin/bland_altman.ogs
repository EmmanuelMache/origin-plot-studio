// Template bland_altman: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/demo_bland_altman/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
win -t data origin L3a;
win -a L3a; impASC fname:="<data folder>/data_for_origin/demo_bland_altman/L3a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L3a]1!;
win -a L3a;
win -t data origin L4a;
win -a L4a; impASC fname:="<data folder>/data_for_origin/demo_bland_altman/L4a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L4a]1!;
win -a L4a;
win -t data origin L5a;
win -a L5a; impASC fname:="<data folder>/data_for_origin/demo_bland_altman/L5a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[L5a]1!;
win -a L5a;
win -t plot line d1a;
win -a d1a;
page.width=3.543*page.resx; page.height=2.531*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i201 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -k 2;
set D2a_B -z 3;
set D2a_B -kf 1;
layer.x.type=1;
layer.y.type=1;
layer.x.from=7.7828588; layer.x.to=61.30388;
layer.y.from=-3.6945883; layer.y.to=6.1711531;
layer.x.inc=10;
layer.x.minor=4;
layer.y.inc=2;
layer.y.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
label -a 34.5434 0 -n T1 x;
T1.text$="Mean of Method A and Method B (unit)";
T1.fsize=7;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=34.5434;
T1.y=-5.10082;
label -a 2.06577 1.23828 -n T2 x;
T2.text$="Method B − Method A (unit)";
T2.fsize=7;
T2.color=color(0,0,0);
T2.attach=2;
T2.rotate=90;
T2.x=2.06577;
T2.y=1.23828;
layer -i200 L3a_B;
set L3a_B -c color(192,20,30);
set L3a_B -w 320;
layer -i200 L4a_B;
set L4a_B -c color(192,20,30);
set L4a_B -w 320;
set L4a_B -d 1;
layer -i200 L5a_B;
set L5a_B -c color(192,20,30);
set L5a_B -w 320;
set L5a_B -d 1;
label -a 58.8711 0.956861 -n T3 x;
T3.text$="Bias 0.96";
T3.fsize=5;
T3.color=color(192,20,30);
T3.attach=2;
T3.x=58.8711-T3.dx/2;
T3.y=0.956861+T3.dy/2;
label -a 58.8711 4.3524 -n T4 x;
T4.text$="+1.96 SD 4.35";
T4.fsize=5;
T4.color=color(192,20,30);
T4.attach=2;
T4.x=58.8711-T4.dx/2;
T4.y=4.3524+T4.dy/2;
label -a 58.8711 0 -n T5 x;
T5.text$="−1.96 SD -2.44";
T5.fsize=5;
T5.color=color(192,20,30);
T5.attach=2;
T5.x=58.8711-T5.dx/2;
T5.y=-2.43868+T5.dy/2;
win -a d1a;
page.active=1;
layer.x.type=1;
layer.y.type=1;
