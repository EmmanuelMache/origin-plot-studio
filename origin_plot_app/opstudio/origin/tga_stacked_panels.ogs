// Template tga_stacked_panels: layout commands (illustrative data)
// Written by Origin Plot Studio: the same commands the app sends to Origin.
[Main]
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=6.234*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=22.000;
win -a d1a;
layer -n;
page.active=2;
layer.unit=1;
layer.left=12.500; layer.top=39.500; layer.width=77.500; layer.height=22.000;
win -a d1a;
layer -n;
page.active=3;
layer.unit=1;
layer.left=12.500; layer.top=67.000; layer.width=77.500; layer.height=22.000;
win -a d1a;
layer -n;
page.active=4;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=22.000;
