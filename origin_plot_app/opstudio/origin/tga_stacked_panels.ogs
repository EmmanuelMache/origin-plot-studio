page.active=6;
layer.unit=1;
layer.left=12.500; layer.top=67.000; layer.width=77.500; layer.height=22.000;
win -a d1a;
page.active=1;
win -t data origin D2a;
win -a D2a; impASC fname:="<data folder>/data_for_origin/D2a.csv" options.Names.AutoNames:=0 options.Names.FNameToBk:=0 options.Names.FNameToSht:=0 options.Names.FNameToBkComm:=0 options.sparklines:=0 orng:=[D2a]1!;
win -a D2a;
layer -i200 D2a_B;
set D2a_B -c color(0,0,0);
set D2a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=-18.5; layer.x.to=1048.5;
layer.y.from=87.793614; layer.y.to=100.50961;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=0;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.show=0;
yl.text$="Mass (%)";
yl.fsize=9;
label -a -18.5 100.51 -n T1 x;
T1.text$="\b((a) Material 2)";
T1.fsize=9;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=-18.5+T1.dx/2;
T1.y=100.51+T1.dy/2;
