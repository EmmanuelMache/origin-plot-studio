win -a D11a;
layer -i200 D11a_B;
set D11a_B -c color(255,127,14);
set D11a_B -w 500;
layer.x.type=1;
layer.y.type=1;
layer.x.from=30; layer.x.to=900;
layer.y.from=-0.94686456; layer.y.to=0.058176081;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=1;
layer.x.label.pt=8; layer.y.label.pt=8;
layer.y2.label.pt=8;
layer.x.thickness=0.8;
layer.y.thickness=0.8;
layer.x2.thickness=0.8;
layer.y2.thickness=0.8;
label -r legend;
xb.text$="Temperature (°C)";
xb.fsize=9;
yl.text$="DTG (% min\+(-1))";
yl.fsize=9;
label -a 115 0.0682265 -n T1 x;
T1.text$="C-S-H / AFt (dehydration)\n(30–200 °C)";
T1.fsize=6;
T1.color=color(0,0,0);
T1.attach=2;
T1.x=115;
T1.y=0.0682265+T1.dy/2;
label -a 200 0.15868 -n T2 x;
T2.text$="AFm zone\n(150–250 °C)";
T2.fsize=6;
T2.color=color(0,0,0);
T2.attach=2;
T2.x=200;
T2.y=0.15868+T2.dy/2;
label -a 475 0.0682265 -n T3 x;
T3.text$="Portlandite Ca(OH)\-(2)\n(400–550 °C)";
T3.fsize=6;
T3.color=color(0,0,0);
T3.attach=2;
T3.x=475;
T3.y=0.0682265+T3.dy/2;
label -a 700 0.15868 -n T4 x;
T4.text$="Calcite (CO\-(2))\n(600–800 °C)";
T4.fsize=6;
T4.color=color(0,0,0);
T4.attach=2;
T4.x=700;
T4.y=0.15868+T4.dy/2;
legend -r;
legend.text$="\l(1) Sample A\n\l(2) Sample B\n\l(3) Sample C\n\l(4) Sample D\n\l(5) Sample E\n\l(6) Sample F";
legend.fsize=8;
legend.background=0;
legend.x=37.8162+legend.dx/2;
legend.y=-0.660426-legend.dy/2;
