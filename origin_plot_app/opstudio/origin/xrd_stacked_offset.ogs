win -a D7a;
win -t plot line d1a;
win -a d1a;
page.width=7.48*page.resx; page.height=4.675*page.resy;
win -a d1a;
page.active=1;
layer.unit=1;
layer.left=12.500; layer.top=12.000; layer.width=77.500; layer.height=77.000;
win -a d1a;
page.active=1;
layer -i200 D2a_B;
set D2a_B -c color(34,34,34);
set D2a_B -w 280;
layer -i200 D3a_B;
set D3a_B -c color(34,34,34);
set D3a_B -w 280;
layer -i200 D4a_B;
set D4a_B -c color(34,34,34);
set D4a_B -w 280;
layer -i200 D5a_B;
