set D5a_B -w 280;
layer -i200 D6a_B;
set D6a_B -c color(34,34,34);
set D6a_B -w 280;
layer -i200 D7a_B;
set D7a_B -c color(34,34,34);
set D7a_B -w 280;
layer.x.type=1;
layer.y.type=1;
layer.x.from=10; layer.x.to=60;
layer.y.from=-238.18089; layer.y.to=6974.3642;
layer.x.inc=10;
layer.x.minor=4;
layer.x.showAxes=3;
layer.y.showAxes=3;
layer.x.ticks=5;
layer.y.ticks=5;
layer.x2.ticks=5;
layer.y2.ticks=5;
layer.x2.showLabels=0;
layer.y2.showLabels=0;
layer.x.showLabels=1;
layer.y.showLabels=0;
layer.x.label.pt=6; layer.y.label.pt=6;
layer.y2.label.pt=6;
layer.x.thickness=0.64;
layer.y.thickness=0.64;
layer.x2.thickness=0.64;
layer.y2.thickness=0.64;
label -r legend;
xb.show=0;
yl.show=0;
yr.show=0;
